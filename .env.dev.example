APP_ENV=dev
APP_NAME=seiwajyuku-platform-api
API_HOST=0.0.0.0
API_PORT=8000
# Build provenance is injected by CI/deployment; unknown is safe for local dev.
APP_VERSION=dev
APP_GIT_SHA=unknown
APP_BUILD_TIME_UTC=unknown
APP_BUILD_ID=unknown
APP_IMAGE_DIGEST=unknown
DATABASE_URL=sqlite:///./data/seiwajyuku_dev.db
JWT_SECRET=dev-only-change-me-0000000000000000
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FIELD_ENCRYPTION_KEY=
INTEGRATION_API_KEY=dev-integration-key
DEPLOYMENT_READ_ONLY=false
RUN_BOOTSTRAP_ON_STARTUP=true
PUBLIC_ENROLLMENT_RATE_LIMIT=12
PUBLIC_ENROLLMENT_RATE_WINDOW_SECONDS=300
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_PAGE=pages/enrollment/index
WECHAT_LOCAL_TEST_MODE=false
CORS_ORIGINS=http://localhost:8848
ALLOW_PRODUCTION_MUTATIONS=false
IDENTITY_AUTHORIZATION_ENABLED=false
IDENTITY_ADMIN_WRITES_ENABLED=false
VOLUNTEER_SERVICE_INVITATIONS_ENABLED=false
MEMBER_SERVICE_SIGNAL_FEEDBACK_ENABLED=false
WECHAT_MEMBER_BINDING_ENABLED=false
STUDY_MEETING_SUBMISSION_ENABLED=false
STUDY_MEETING_REVIEW_ENABLED=false
STUDY_MEETING_EVIDENCE_ENABLED=false
STUDY_MEETING_COURSE_EDIT_ENABLED=false
STUDY_MEETING_ATTENDEE_EDIT_ENABLED=false
STUDY_EVIDENCE_RETENTION_HOURS=168
STUDY_EVIDENCE_STORAGE_BACKEND=local
STUDY_EVIDENCE_LOCAL_ROOT=
STUDY_EVIDENCE_CLEANUP_ENABLED=false
STUDY_EVIDENCE_CLEANUP_GRACE_SECONDS=900
STUDY_EVIDENCE_CLEANUP_PREFIX=study-meetings/
# Server-to-server cleanup token (only needed when the protected test endpoint is exercised).
STUDY_EVIDENCE_CLEANUP_TOKEN=
LEARNING_CREDIT_SETTLEMENT_ENABLED=false
AGENT_API_ENABLED=false
AGENT_CLIENT_ID=workbuddy_ops
AGENT_CLIENT_SECRET=replace-with-at-least-32-random-characters
AGENT_ALLOWED_CHANNELS=api,wecom,wechat
MCP_ALLOWED_HOSTS=testserver,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
AGENT_ALLOWED_TOOLS=get_my_today_actions,find_member,get_member_summary,get_member_timeline,get_renewal_context,get_followup_context
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=dev-admin-change-me
