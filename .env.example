APP_ENV=dev
APP_NAME=seiwajyuku-platform-api
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/seiwajyuku_dev.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
INTEGRATION_API_KEY=replace-with-random-integration-key
DEPLOYMENT_READ_ONLY=false
RUN_BOOTSTRAP_ON_STARTUP=false
CORS_ORIGINS=http://localhost:8848
ALLOW_PRODUCTION_MUTATIONS=false
CLASS_ROSTER_ORG_IMPORT_ENABLED=false
IDENTITY_AUTHORIZATION_ENABLED=false
IDENTITY_ADMIN_WRITES_ENABLED=false
VOLUNTEER_SERVICE_INVITATIONS_ENABLED=false
MEMBER_SERVICE_SIGNAL_FEEDBACK_ENABLED=false
AGENT_API_ENABLED=false
AGENT_CLIENT_ID=workbuddy_ops
AGENT_CLIENT_SECRET=replace-with-at-least-32-random-characters
AGENT_ALLOWED_CHANNELS=api,wecom,wechat
AGENT_ALLOWED_TOOLS=get_my_today_actions,find_member,get_member_summary,get_member_timeline,get_renewal_context,get_followup_context
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
SIGNIN_API_BASE_URL=http://host.docker.internal:9000
SIGNIN_SERVICE_API_KEY=
READING_API_BASE_URL=
READING_SERVICE_API_KEY=
