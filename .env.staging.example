APP_ENV=staging
APP_NAME=seiwajyuku-platform-api
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=mysql+pymysql://seiwajyuku:replace-me@mysql:3306/seiwajyuku_staging?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
INTEGRATION_API_KEY=replace-with-random-integration-key
DEPLOYMENT_READ_ONLY=false
CORS_ORIGINS=https://staging.example.invalid
ALLOW_PRODUCTION_MUTATIONS=false
IDENTITY_AUTHORIZATION_ENABLED=false
IDENTITY_ADMIN_WRITES_ENABLED=false
VOLUNTEER_SERVICE_INVITATIONS_ENABLED=false
MEMBER_SERVICE_SIGNAL_FEEDBACK_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=staging-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-start
MYSQL_DATABASE=seiwajyuku_staging
MYSQL_USER=seiwajyuku
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password
