<view class="page-shell daily-checkin">
  <view class="brand-header">
    <view class="brand-lockup"><image class="brand-logo" src="/assets/shenghe-brand-logo-jiangnan.png" mode="aspectFit" aria-label="江南塾徽" /></view>
    <view class="page-title">今日签到</view>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在加载当前活动…</view>
  <view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <view wx:if="{{rescueNotice}}" class="section-card"><view class="section-title">现场备用签到</view><view class="section-hint">{{rescueNotice}}</view></view>
  <view wx:if="{{!loading}}" class="daily-toolbar">
    <view class="daily-heading">活动场次</view>
    <button class="plain-button daily-refresh" bindtap="loadEvents">刷新活动</button>
  </view>
  <view wx:if="{{!loading && !errorMessage && !events.length}}" class="state-card">当前没有可签到的活动。</view>
  <button wx:for="{{events}}" wx:key="event_id" class="section-card daily-event" data-event-id="{{item.event_id}}" bindtap="openEvent">
    <view class="daily-event-copy"><view class="section-title">{{item.title}}</view><view class="detail-line">{{item.event_date_display}} · {{item.session_name}}</view></view>
    <view class="daily-status {{item.checkin_status === 'open' ? 'daily-open' : ''}}">{{item.checkin_status === 'open' ? '去签到 ›' : item.checkin_status === 'upcoming' ? '未开放' : '已结束'}}</view>
  </button>
</view>
