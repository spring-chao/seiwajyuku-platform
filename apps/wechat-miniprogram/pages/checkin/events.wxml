<view class="page-shell">
  <view class="brand-header">
    <view class="brand-lockup"><image class="brand-logo" src="/assets/shenghe-brand-logo-jiangnan.png" mode="aspectFit" aria-label="江南塾徽" /></view>
    <view class="brand-motto">提高心性 拓展经营</view><view class="page-title">活动签到</view>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在加载当前活动…</view>
  <view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <view wx:if="{{rescueNotice}}" class="section-card"><view class="section-title">现场备用签到</view><view class="section-hint">{{rescueNotice}}</view></view>
  <button wx:if="{{!loading}}" class="plain-button" bindtap="loadEvents">刷新活动</button>
  <view wx:if="{{!loading && !errorMessage && !events.length}}" class="state-card">当前没有可签到的活动，请联系工作人员。</view>
  <view wx:for="{{events}}" wx:key="event_id" class="section-card" data-event-id="{{item.event_id}}" bindtap="openEvent">
    <view class="section-title">{{item.title}}</view><view class="detail-line">{{item.event_date_display}} · {{item.session_name}}</view><view class="section-hint">{{item.checkin_status === 'open' ? '当前可签到，进入本场次 →' : item.checkin_status === 'upcoming' ? '签到尚未开放' : '签到已结束'}}</view>
  </view>
</view>
