<view class="page-shell">
  <view wx:if="{{!result}}" class="brand-header">
    <view class="brand-lockup"><image class="brand-logo" src="/assets/shenghe-brand-logo-jiangnan.png" mode="aspectFit" aria-label="江南塾徽" /></view>
    <view class="brand-motto">提高心性 拓展经营</view>
    <view class="page-title">活动签到</view>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在确认活动与身份…</view>
  <view wx:if="{{event && !result}}" class="section-card activity-shell">
    <view class="activity-heading">本次签到活动</view>
    <view class="activity-card">
      <view class="activity-top"><view class="activity-dot"></view><view class="activity-name">{{event.title}}</view></view>
      <view class="activity-date">{{event.event_date_display}} · {{event.session_name}}</view>
    </view>
    <view class="section-hint">{{konpaRequired ? '上午、下午分别签到；空巴参加选择由负责人核实，学员无需再次扫码。' : '各场次分别签到，上午签到不会代替下午或空巴签到。'}}</view>
  </view>
  <view wx:if="{{member && !result}}" class="section-card">
    <view class="section-title">本人</view><view class="identity-name">{{member.name || member.name_masked}}</view>
    <view class="detail-line">{{member.class_name || '暂未关联班级'}}{{member.group_name ? ' · ' + member.group_name : ''}}</view>
    <view wx:if="{{registration.registered_name}}" class="section-hint">报名记录：{{registration.registered_name}}</view>
    <view wx:if="{{konpaRequired && canCheckin && !alreadyChecked}}">
      <view class="input-label">{{event.session_code === 'MORNING' ? '预计是否参加空巴（用于订餐）' : '是否参加空巴'}}</view>
      <radio-group bindchange="chooseKonpa"><label><radio value="yes" checked="{{konpaChoice === true}}" disabled="{{confirming}}" />参加</label><label><radio value="no" checked="{{konpaChoice === false}}" disabled="{{confirming}}" />不参加</label></radio-group>
    </view>
    <button wx:if="{{canCheckin && !alreadyChecked}}" class="primary-button" style="width:100%;" loading="{{confirming}}" disabled="{{confirming || loading || (konpaRequired && konpaChoice === null)}}" bindtap="confirmCheckin">确认本人签到</button>
  </view>
  <view wx:if="{{!result && !guestAllowed && (notice || alreadyChecked)}}" class="state-card {{alreadyChecked ? 'success' : ''}}">{{notice || '本场次已签到'}}</view>
  <button wx:if="{{member && alreadyChecked && !result}}" class="plain-button" bindtap="openHistory">查看我的参与记录</button>
  <view wx:if="{{result && successCard}}" class="result-card">
    <view class="check-icon">✅</view>
    <view class="welcome">{{successCard.welcome}}</view>
    <view wx:for="{{successCard.seats}}" wx:key="*this" class="seat-item">{{item}}</view>
    <view class="result-info"><view wx:for="{{successCard.lines}}" wx:key="index">{{item}}</view></view>
  </view>
  <view wx:for="{{guestResults}}" wx:key="key" class="result-card">
    <view class="check-icon">✅</view>
    <view class="welcome">{{item.card.welcome}}</view>
    <view wx:for="{{item.card.seats}}" wx:for-item="seat" wx:key="*this" class="seat-item">{{seat}}</view>
    <view class="result-info"><view wx:for="{{item.card.lines}}" wx:for-item="line" wx:key="index">{{line}}</view></view>
  </view>
  <view wx:if="{{guestAllowed && !loading && !alreadyChecked}}" class="section-card">
    <view wx:if="{{konpaRequired}}"><view class="input-label">是否参加空巴（必选）</view><radio-group bindchange="chooseKonpa"><label><radio value="yes" checked="{{konpaChoice === true}}" disabled="{{confirming}}" />参加</label><label><radio value="no" checked="{{konpaChoice === false}}" disabled="{{confirming}}" />不参加</label></radio-group></view>
    <view class="section-title">✍️ 签到</view>
    <view class="section-hint">输入报名姓名，确认签到。</view>
    <view class="input-label">姓名</view>
    <input class="name-input" placeholder="请输入报名姓名" maxlength="120" value="{{guestName}}" bindinput="inputGuestName" disabled="{{confirming || guestResults.length > 0}}" />
    <view wx:if="{{nameCandidates.length > 1}}" class="candidate-section">
      <view class="candidate-heading">找到多条同名报名</view>
      <view class="candidate-hint">请核对并勾选需要签到的报名信息，可多选。</view>
      <checkbox-group bindchange="selectGuestCandidates">
        <label wx:for="{{nameCandidates}}" wx:key="registration_id" class="candidate-option {{item.selected ? 'candidate-selected' : ''}} {{item.completed ? 'candidate-completed' : ''}}">
          <checkbox class="candidate-checkbox" color="#741f2b" value="{{index}}" checked="{{item.selected}}" disabled="{{confirming || item.completed}}" />
          <view class="candidate-copy">
            <view class="candidate-name">{{item.registered_name || item.name}}<text class="candidate-number">报名 {{index + 1}}</text></view>
            <view wx:if="{{item.class_name || item.group_name}}" class="candidate-detail">{{item.class_name}}{{item.group_name ? ' · ' + item.group_name : ''}}</view>
            <view wx:if="{{item.company || item.center}}" class="candidate-detail">{{item.company}}{{item.company && item.center ? ' · ' : ''}}{{item.center}}</view>
            <view wx:if="{{item.completed}}" class="candidate-status">签到已确认</view>
            <view wx:elif="{{item.checked_in}}" class="candidate-detail">已签到，可查看原签到结果</view>
            <view wx:if="{{item.error}}" class="candidate-error">{{item.error}}</view>
          </view>
        </label>
      </checkbox-group>
    </view>
    <button class="primary-button" style="width:100%;" loading="{{confirming}}" disabled="{{confirming || (konpaRequired && konpaChoice === null) || (nameCandidates.length > 1 && !selectedCandidateIndexes.length)}}" bindtap="submitGuest">{{nameCandidates.length > 1 ? '确认签到（' + selectedCandidateIndexes.length + '）' : '确认签到'}}</button>
    <button class="binding-entry" style="width:100%;" disabled="{{confirming}}" bindtap="openBinding">
      <view class="binding-copy"><view class="binding-title">塾生身份绑定</view><view class="binding-hint">绑定后，后续活动可直接确认签到</view></view>
      <text class="binding-arrow">›</text>
    </button>
  </view>
  <view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <view wx:if="{{rescueNotice}}" class="section-card"><view class="section-title">现场备用签到</view><view class="section-hint">{{rescueNotice}}</view></view>
  <button wx:if="{{errorMessage && !confirming}}" class="plain-button" bindtap="loadContext">重新确认活动</button>
  <view wx:if="{{fallbackAvailable && !loading && !result}}" class="section-card">
    <view class="section-title">备用现场签到</view><view class="section-hint">团队报名、来宾或无法匹配报名时，可使用原有现场签到流程；也可联系工作人员协助。</view>
    <button class="plain-button" bindtap="openFallback">姓名 / 团队 / 来宾签到</button>
  </view>
</view>
