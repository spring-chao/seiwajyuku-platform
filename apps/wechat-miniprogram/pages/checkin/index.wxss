/* Reuse the original signin public/index.html palette and card/button styling. */
page { background: #431019; }
.page-shell { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 56rpx; background: linear-gradient(160deg, #431019 0%, #5a151c 46%, #741f28 100%); color: #2e1719; }
.brand-header { padding: 24rpx 0 36rpx; text-align: center; color: #fff; }
.brand-lockup { display: flex; align-items: center; justify-content: center; width: 360rpx; max-width: 100%; box-sizing: border-box; margin: 0 auto; padding: 20rpx 24rpx; border-radius: 36rpx; background: #f7f1e8; box-shadow: 0 20rpx 48rpx rgba(25, 5, 8, .22); }
.brand-logo { display: block; width: 312rpx; height: 59rpx; }
.brand-motto { margin-top: 26rpx; font-size: 24rpx; letter-spacing: 6rpx; color: #f5d9d2; }
.page-title { margin-top: 32rpx; font-size: 40rpx; font-weight: 700; }
.section-card, .state-card { margin-top: 32rpx; padding: 44rpx; border: 1rpx solid rgba(255, 255, 255, .45); border-radius: 40rpx; background: #f7f1e8; box-shadow: 0 24rpx 56rpx rgba(25, 5, 8, .18); }
.activity-shell { margin-top: 0; padding: 32rpx; border-radius: 36rpx; }
.activity-heading { margin-bottom: 24rpx; font-size: 34rpx; font-weight: 700; color: #5b181d; }
.activity-card { padding: 26rpx 28rpx; border: 1rpx solid #a43a40; border-radius: 28rpx; background: #fff3ed; box-shadow: 0 12rpx 32rpx rgba(136, 27, 27, .14); }
.activity-top { display: flex; align-items: center; gap: 16rpx; }
.activity-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #a43a40; flex-shrink: 0; }
.activity-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.activity-date { margin-top: 10rpx; padding-left: 34rpx; font-size: 26rpx; color: #846363; line-height: 1.6; }
.input-label { margin-top: 28rpx; font-size: 28rpx; color: #795858; }
.section-title { color: #5b181d; font-size: 34rpx; font-weight: 700; line-height: 1.45; }
.detail-line { margin-top: 14rpx; font-size: 27rpx; line-height: 1.6; word-break: break-all; }
.section-hint { margin-top: 16rpx; color: #806f6f; line-height: 1.65; font-size: 25rpx; }
.identity-name { margin-top: 18rpx; color: #741f2b; font-size: 35rpx; font-weight: 700; }
.primary-button, .plain-button { width: 100%; box-sizing: border-box; margin: 22rpx 0 0; padding: 24rpx 20rpx; border-radius: 16rpx; font-size: 32rpx; line-height: 1.5; }
.primary-button { min-height: 104rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg, #8d242b, #68151d); letter-spacing: 2rpx; box-shadow: 0 16rpx 32rpx rgba(104, 21, 29, .2); }
.primary-button[disabled] { background: #b69b9f; color: #fff; box-shadow: none; }
.primary-button::after, .plain-button::after { border: none; }
.plain-button { color: #741f2b; background: #fffaf7; border: 1rpx solid #d9c7c3; }
.success { background: #ecf6ef; color: #2b6640; }
.error { color: #b33b44; }
.name-input { box-sizing: content-box; margin: 12rpx 0 24rpx; padding: 28rpx 32rpx; height: 48rpx; font-size: 32rpx; color: #3b2020; border: 1rpx solid #ddc9c3; border-radius: 22rpx; background: #fffaf4; }
.candidate-section { margin-top: 28rpx; }
.candidate-heading { font-size: 28rpx; font-weight: 700; }
.candidate-hint { margin: 10rpx 0 20rpx; font-size: 24rpx; line-height: 1.6; color: #806f6f; }
.candidate-option { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 24rpx; border: 2rpx solid #e9dfd9; border-radius: 18rpx; background: #fffaf7; }
.candidate-selected { border-color: #741f2b; background: #fbf0f0; }
.candidate-completed { border-color: #c8dfce; background: #f0f7f2; }
.candidate-checkbox { flex-shrink: 0; }
.candidate-copy { flex: 1; min-width: 0; }
.candidate-name { font-size: 30rpx; line-height: 1.5; font-weight: 700; word-break: break-all; }
.candidate-number { margin-left: 16rpx; font-size: 22rpx; font-weight: 400; color: #806f6f; }
.candidate-detail, .candidate-status, .candidate-error { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; word-break: break-all; color: #806f6f; }
.candidate-status { color: #2b6640; }
.candidate-error { color: #b33b44; }
.binding-entry { display: flex; align-items: center; justify-content: space-between; width: 100%; box-sizing: border-box; margin: 28rpx 0 0; padding: 24rpx; border-radius: 16rpx; text-align: left; border: 1rpx solid #ddc9c3; background: #fffaf4; color: #741f2b; line-height: 1.5; }
.binding-entry::after { border: none; }
.binding-copy { flex: 1; min-width: 0; }
.binding-title { font-size: 28rpx; font-weight: 700; }
.binding-hint { margin-top: 6rpx; color: #806f6f; font-size: 23rpx; }
.binding-arrow { margin-left: 20rpx; font-size: 44rpx; font-weight: 400; }
.result-card { margin-top: 24rpx; padding: 48rpx 40rpx; background: #f7f1e8; border: 2rpx solid #e2c8c1; border-radius: 32rpx; text-align: center; }
.check-icon { font-size: 112rpx; margin-bottom: 16rpx; }
.welcome { font-size: 40rpx; font-weight: 700; margin-bottom: 24rpx; color: #2c8558; }
.seat-item { font-size: 44rpx; font-weight: 700; color: #8d242b; margin: 12rpx 0; padding: 20rpx 32rpx; background: #f7e4dc; border-radius: 20rpx; display: inline-block; }
.result-info { font-size: 26rpx; color: #795858; line-height: 1.6; margin-top: 16rpx; }
