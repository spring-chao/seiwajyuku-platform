<view class="page-shell">
  <view wx:if="{{state === 'selecting' && !submitted}}" class="selection-card">
    <view class="hero-card">
      <view class="eyebrow">新学长入塾申请</view>
      <view class="hero-title">请选择您准备加入的塾</view>
      <view class="hero-copy">先选择实际加入的塾，下一步填写统一资料表。江南塾为上级组织，不作为申请目标。</view>
    </view>
    <view class="target-shuku-card selection-target-card">
      <view class="target-shuku-title">申请加入哪个塾？ <text class="required-mark">*</text></view>
      <view class="target-shuku-options">
        <view wx:for="{{targetShukuOptions}}" wx:key="id" class="target-shuku-option {{item.id == selectedTargetShukuId ? 'selected' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="handleTargetShukuSelect">
          <view class="target-shuku-option-name">{{item.name}}</view>
          <view wx:if="{{item.id == selectedTargetShukuId}}" class="target-shuku-option-check">✓</view>
        </view>
      </view>
      <view wx:if="{{selectedTargetShukuName}}" class="selection-summary">已选择：<text>{{selectedTargetShukuName}}</text></view>
      <button class="selection-next-button" loading="{{state === 'loading'}}" disabled="{{!selectedTargetShukuId || state === 'loading'}}" bindtap="continueToForm">下一步，填写资料</button>
    </view>
  </view>
  <scroll-view wx:if="{{state === 'ready' && !submitted}}" class="page-scroll" scroll-y>
    <view class="hero-card compact-hero">
      <view class="hero-brand">
        <view class="brand-lockup">
          <image class="brand-logo" src="/assets/shenghe-brand-logo.png" mode="aspectFit" />
          <text class="brand-region">{{brandRegionName}}</text>
        </view>
        <view class="brand-slogan">提高心性 · 拓展经营</view>
      </view>
    </view>

    <view wx:if="{{!targetShukuLocked}}" class="target-shuku-card">
      <view class="card-kicker">申请加入</view>
      <view class="target-shuku-title">{{formMeta.target_shuku_name || '已选择申请塾'}} <text class="required-mark">*</text></view>
      <view class="target-shuku-locked">
        <view class="target-shuku-name">{{formMeta.target_shuku_name}}</view>
        <view class="target-shuku-hint">提交前可以更改申请塾，资料表主体不会改变。</view>
        <button class="plain-button" bindtap="changeTargetShuku">更改申请塾</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <view class="section-index">01</view>
        <view class="section-heading-copy">
          <view class="section-title">基础信息</view>
          <view class="section-description">用于建立申请人基本档案</view>
        </view>
      </view>
      <view class="field-row">
        <view class="field-label required">姓名</view>
        <input class="field-input" data-field="name" value="{{form.name}}" bindinput="handleInput" placeholder="请填写真实姓名" />
      </view>
      <view class="field-row">
        <view class="field-label required">手机号</view>
        <input class="field-input" type="number" maxlength="11" data-field="phone" value="{{form.phone}}" bindinput="handleInput" placeholder="用于审核联系，将加密保存" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">出生日期</view>
        <picker mode="date" value="{{form.birthday}}" start="1900-01-01" end="{{birthdayMax}}" bindchange="handleBirthdayChange">
          <view class="picker-value {{form.birthday ? '' : 'placeholder'}}">{{form.birthday || '请选择出生日期'}}</view>
        </picker>
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">性别</view>
        <picker mode="selector" range="{{genderOptions}}" bindchange="handleGenderChange">
          <view class="picker-value {{form.gender ? '' : 'placeholder'}}">{{form.gender === 'MALE' ? '男' : form.gender === 'FEMALE' ? '女' : '请选择'}}</view>
        </picker>
      </view>
      <view class="field-row">
        <view class="field-label required">推荐人</view>
        <input class="field-input" data-field="referrer" value="{{form.referrer}}" bindinput="handleInput" placeholder="请填写推荐学长姓名" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">政治面貌</view>
        <picker mode="selector" range="{{politicalOptions}}" bindchange="handlePoliticalStatusChange">
          <view class="picker-value {{form.political_status ? '' : 'placeholder'}}">{{form.political_status || '请选择'}}</view>
        </picker>
      </view>
      <view wx:if="{{form.political_status === '党员'}}" class="field-row">
        <view class="field-label">党员承担的社会角色</view>
        <input class="field-input" data-field="social_role" value="{{form.social_role}}" bindinput="handleInput" placeholder="如：人大代表、政协委员、行业协会职务（可选）" />
      </view>
      <view class="field-row">
        <view class="field-label">邮箱</view>
        <input class="field-input" data-field="email" value="{{form.email}}" bindinput="handleInput" placeholder="可选" />
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <view class="section-index">02</view>
        <view class="section-heading-copy">
          <view class="section-title">企业信息</view>
          <view class="section-description">了解企业经营基本情况</view>
        </view>
      </view>
      <view class="field-row">
        <view class="field-label required">公司名称</view>
        <input class="field-input" data-field="company_name" value="{{form.company_name}}" bindinput="handleInput" placeholder="请手工填写企业全称" />
      </view>
      <view class="field-row">
        <view class="field-label required">公司地址</view>
        <input class="field-input" data-field="company_address" value="{{form.company_address}}" bindinput="handleInput" maxlength="1000" placeholder="请填写公司完整地址" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">职务</view>
        <picker mode="selector" range="{{positionOptions}}" bindchange="handlePositionChange">
          <view class="picker-value {{form.position ? '' : 'placeholder'}}">{{form.position || '请选择职务'}}</view>
        </picker>
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">所属行业</view>
        <picker mode="selector" range="{{industryOptions}}" bindchange="handleIndustryChange">
          <view class="picker-value {{form.industry_category ? '' : 'placeholder'}}">{{form.industry_category || '请选择所属行业'}}</view>
        </picker>
      </view>
      <view wx:if="{{isIndustryOther}}" class="field-row">
        <view class="field-label required">其他行业</view>
        <input class="field-input" data-field="industry_other" value="{{form.industry_other}}" bindinput="handleInput" placeholder="请填写行业名称" />
      </view>
      <view class="field-row">
        <view class="field-label required">员工人数</view>
        <input class="field-input" type="number" data-field="employee_count" value="{{form.employee_count}}" bindinput="handleInput" placeholder="请输入人数" />
      </view>
      <view class="field-row multiline-row compact-multiline-row">
        <view class="field-label required">主要产品或服务</view>
        <textarea class="field-textarea" data-field="company_products" value="{{form.company_products}}" bindinput="handleInput" maxlength="4000" placeholder="请填写主要产品或服务" />
      </view>
      <view class="field-row">
        <view class="field-label required">年销售额（万）</view>
        <input class="field-input" type="digit" data-field="annual_sales" value="{{form.annual_sales}}" bindinput="handleInput" placeholder="请输入金额" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">利润率</view>
        <picker mode="selector" range="{{profitOptions}}" bindchange="handleProfitChange">
          <view class="picker-value {{form.profit_margin ? '' : 'placeholder'}}">{{form.profit_margin === 'GE_10_PERCENT' ? '10%及以上' : form.profit_margin === 'LT_10_PERCENT' ? '0%～10%以下' : form.profit_margin === 'LOSS' ? '亏损' : '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <view class="section-index">03</view>
        <view class="section-heading-copy">
          <view class="section-title">开票信息</view>
          <view class="section-description">按实际需要填写</view>
        </view>
      </view>
      <view class="section-hint">发票抬头和税号为手工填写，请提交前自行核对。</view>
      <view class="field-row picker-row">
        <view class="field-label required">发票类型</view>
        <picker mode="selector" range="{{invoiceOptions}}" bindchange="handleInvoiceChange">
          <view class="picker-value {{form.invoice_type ? '' : 'placeholder'}}">{{form.invoice_type === 'NORMAL' ? '普票' : form.invoice_type === 'SPECIAL' ? '专票' : form.invoice_type === 'NONE' ? '无需开票' : '请选择'}}</view>
        </picker>
      </view>
      <block wx:if="{{isInvoiceDetailsVisible}}">
        <view class="field-row">
          <view class="field-label required">发票抬头</view>
          <input class="field-input" data-field="invoice_title" value="{{form.invoice_title}}" bindinput="handleInput" placeholder="请填写发票抬头" />
        </view>
        <view class="field-row">
          <view class="field-label required">发票税号</view>
          <input class="field-input" data-field="invoice_tax_id" value="{{form.invoice_tax_id}}" bindinput="handleInput" placeholder="请填写税号" />
        </view>
      </block>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <view class="section-index">04</view>
        <view class="section-heading-copy">
          <view class="section-title">学习期望</view>
          <view class="section-description">了解未来学习目标</view>
        </view>
      </view>
      <view class="section-question">你希望通过学习服务获得什么？</view>
      <view class="field-row picker-row">
        <view class="field-label required">计划学习年限</view>
        <picker mode="selector" range="{{goalYearOptions}}" bindchange="handleGoalYearsChange">
          <view class="picker-value {{form.goal_years ? '' : 'placeholder'}}">{{form.goal_years ? (form.goal_years === '1' ? '1年' : form.goal_years === '2' ? '2年' : form.goal_years === '3' ? '3年' : form.goal_years === '5' ? '5年' : '自定义') : '请选择'}}</view>
        </picker>
      </view>
      <view wx:if="{{isGoalYearsOther}}" class="field-row">
        <view class="field-label required">自定义年限</view>
        <input class="field-input" type="number" data-field="goal_years_other" value="{{form.goal_years_other}}" bindinput="handleInput" placeholder="请输入年数" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">业绩提升目标</view>
        <picker mode="selector" range="{{growthOptions}}" bindchange="handleRevenueGrowthChange">
          <view class="picker-value {{form.revenue_growth_target ? '' : 'placeholder'}}">{{form.revenue_growth_target === '1.5' ? '1.5倍' : form.revenue_growth_target === '2' ? '2倍' : form.revenue_growth_target === '3' ? '3倍' : form.revenue_growth_target === '5' ? '5倍' : form.revenue_growth_target === 'CUSTOM' ? '自定义' : '请选择'}}</view>
        </picker>
      </view>
      <view wx:if="{{isRevenueCustom}}" class="field-row">
        <view class="field-label required">自定义业绩目标</view>
        <input class="field-input" type="digit" data-field="revenue_growth_other" value="{{form.revenue_growth_other}}" bindinput="handleInput" placeholder="请输入倍数" />
      </view>
      <view class="field-row picker-row">
        <view class="field-label required">利润提升目标</view>
        <picker mode="selector" range="{{growthOptions}}" bindchange="handleProfitGrowthChange">
          <view class="picker-value {{form.profit_growth_target ? '' : 'placeholder'}}">{{form.profit_growth_target === '1.5' ? '1.5倍' : form.profit_growth_target === '2' ? '2倍' : form.profit_growth_target === '3' ? '3倍' : form.profit_growth_target === '5' ? '5倍' : form.profit_growth_target === 'CUSTOM' ? '自定义' : '请选择'}}</view>
        </picker>
      </view>
      <view wx:if="{{isProfitCustom}}" class="field-row">
        <view class="field-label required">自定义利润目标</view>
        <input class="field-input" type="digit" data-field="profit_growth_other" value="{{form.profit_growth_other}}" bindinput="handleInput" placeholder="请输入倍数" />
      </view>
      <view class="field-row multiline-row">
        <view class="field-label">补充说明</view>
        <textarea class="field-textarea" data-field="notes" value="{{form.notes}}" bindinput="handleInput" maxlength="1000" placeholder="还有想让工作人员了解的内容，可选填写" />
      </view>
    </view>

    <view class="rules-card">
      <view class="support-heading">
        <view class="support-kicker">05 · 重要说明</view>
        <view class="section-title">加入守则与缴费说明</view>
      </view>
      <view class="purpose-summary">
        <view class="purpose-summary-title">这份资料会用于</view>
        <view wx:for="{{purposeItems}}" wx:key="title" class="purpose-summary-item">
          <view>{{item.title}}</view><view class="purpose-item-copy">{{item.description}}</view>
        </view>
      </view>
      <view class="joining-summary">
        <view class="joining-summary-title">申请前，请先了解</view>
        <view wx:for="{{joiningDocument.summary}}" wx:key="*this" class="joining-summary-item"><text class="joining-summary-number">{{index + 1}}</text><text>{{item}}</text></view>
      </view>
      <view wx:if="{{joiningDocument.businessReady && (joiningDocument.contacts.length || joiningDocument.serviceAddress)}}" class="contact-card">
        <view class="contact-card-title">咨询与联系</view>
        <view wx:for="{{joiningDocument.contacts}}" wx:key="index" class="contact-line">
          <text class="contact-name">{{item.name}}</text>
          <button wx:if="{{item.phone}}" class="contact-phone" data-index="{{index}}" bindtap="copyContactPhone" aria-label="复制{{item.name}}联系电话">{{item.phone}}</button>
        </view>
        <view wx:if="{{joiningDocument.contacts.length}}" class="copy-hint">点击联系电话可复制</view>
        <view wx:if="{{joiningDocument.serviceAddress}}" class="service-address"><view class="service-address-label">服务地址</view><view>{{joiningDocument.serviceAddress}}</view></view>
      </view>
      <view class="rules-detail-entry" bindtap="openJoiningRules" role="button" aria-label="查看加入守则与缴费说明详情">
        <view><view class="rules-detail-title">《{{joiningDocument.title || '加入守则与缴费说明'}}》</view><view class="rules-detail-hint">点击查看条件、流程、缴费、学习与退费详情</view></view><text class="rules-detail-arrow">›</text>
      </view>
      <view class="warm-tip">{{formMeta.notice}}</view>
      <view class="consent-row" bindtap="toggleRules">
        <view class="checkbox {{rulesAcknowledged ? 'checked' : ''}}">{{rulesAcknowledged ? '✓' : ''}}</view>
        <view>我已阅读并确认<text class="privacy-link" catchtap="openJoiningRules">《加入守则与缴费说明》</text></view>
      </view>
    </view>

    <view class="privacy-card">
      <view class="support-heading">
        <view class="support-kicker">06 · 隐私确认</view>
        <view class="section-title">资料使用说明</view>
      </view>
      <view class="consent-row" bindtap="togglePrivacy">
        <view class="checkbox {{privacyConsent ? 'checked' : ''}}">{{privacyConsent ? '✓' : ''}}</view>
        <view>我已阅读并同意<text class="privacy-link" catchtap="openPrivacyContract">《用户隐私保护指引》</text></view>
      </view>
      <view class="privacy-copy">{{formMeta.privacy_notice}}</view>
    </view>

    <view class="submit-area">
      <button class="submit-button" loading="{{submitting}}" disabled="{{submitting || !rulesAcknowledged || !privacyConsent}}" hover-class="submit-button-pressed" bindtap="submit">{{submitting ? '正在提交' : '提交入塾申请'}}</button>
      <view wx:if="{{!rulesAcknowledged || !privacyConsent}}" class="submit-hint">请阅读并勾选以上两项确认</view>
      <view class="footer-copy">提交后，工作人员将审核并与您联系</view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="state-card">
    <view class="state-icon loading-icon">···</view>
    <view class="state-title">正在加载登记入口</view>
    <view class="state-copy">请稍候</view>
  </view>
  <view wx:if="{{state === 'error'}}" class="state-card">
    <view class="state-icon error-icon">!</view>
    <view class="state-title">登记入口暂不可用</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="retry-button" bindtap="retry">重新加载</button>
  </view>
  <view wx:if="{{submitted}}" class="state-card success-card">
    <view class="state-icon success-icon">✓</view>
    <view class="state-title">资料已提交</view>
    <view class="state-copy">感谢您的填写。工作人员审核资料、确认相关信息后，会与您联系。</view>
    <view class="state-copy strong-copy">当前尚未正式入塾，无需重复提交。</view>
  </view>
</view>
