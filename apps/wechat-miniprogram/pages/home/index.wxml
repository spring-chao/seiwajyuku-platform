<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">盛和塾运营平台 · {{environment}}</view>
    <view class="hero-title">学长服务助手</view>
    <view class="hero-copy">入塾申请、身份绑定和小组学习会，都从这里开始。</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在加载，请稍候…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>

  <view wx:if="{{!loading}}" class="section-card">
    <view class="section-title">我的入口</view>
    <view wx:if="{{member}}" class="identity-card">
      <view class="identity-name">{{member.name_masked}}</view>
      <view class="identity-copy">{{member.class_name || '暂未关联班级'}} · {{member.study_group_name || '暂未关联小组'}}</view>
      <button class="primary-button" bindtap="openStudyMeeting">登记小组学习会</button>
      <button class="plain-button" bindtap="unbind">解除本机绑定</button>
    </view>
    <view wx:else class="identity-card">
      <view class="identity-name">尚未绑定正式学员身份</view>
      <view class="identity-copy">组长或辅导员首次使用时，输入姓名和手机号即可完成绑定。</view>
      <button class="primary-button" bindtap="openBinding">绑定我的学员身份</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">新学长服务</view>
    <view class="section-hint">公开申请只用于入塾审核，不会直接建立正式学员档案。</view>
    <button class="primary-button" bindtap="openEnrollment">填写新学长入塾申请</button>
  </view>

  <view class="footer-copy">普通学长无需扫码签到，由组长在学习会登记时统一选择参加人员。</view>
</view>
