<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">学长服务</view>
    <view class="hero-title">{{identityState === 'bound' ? '欢迎回来' : '学长服务助手'}}</view>
    <view class="hero-copy">{{identityState === 'bound' ? '学习服务从这里开始' : identityState === 'unbound' ? '新学长申请和学长服务，从这里开始' : '学长服务'}}</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在加载，请稍候…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <button wx:if="{{!loading && (errorMessage || (isVolunteer && serviceMessage))}}" class="plain-button" bindtap="loadHome">重新加载</button>

  <view wx:if="{{!loading && identityState !== 'unknown'}}" class="section-card">
    <view class="section-title">我的入口</view>
    <view wx:if="{{member}}" class="identity-card">
      <view class="identity-name">{{member.name_masked}}</view>
      <view wx:if="{{displayRole}}" class="identity-role">{{displayRole}}</view>
      <view class="identity-copy">{{displayScope || '暂未关联班级 · 暂未关联小组'}}</view>
      <view wx:if="{{canManageStudyMeeting}}" class="identity-copy">可从下方“扫码”进入学习会登记。</view>
      <view wx:elif="{{isVolunteer}}" class="identity-copy">{{serviceMessage}}</view>
      <!-- Keep the old action contract for older test fixtures; the visible
           entry now lives in the four-entry grid below. -->
      <button wx:if="{{canManageStudyMeeting}}" class="primary-button" bindtap="openStudyMeeting" hidden="{{true}}">小组学习会登记</button>
      <button class="plain-button" bindtap="unbind">解除本机绑定</button>
    </view>
    <view wx:else class="identity-card">
      <view class="identity-name">尚未绑定正式学员身份</view>
      <view class="identity-copy">在册学长首次使用，输入姓名和手机号即可绑定。</view>
      <button class="primary-button" bindtap="openBinding">绑定我的学员身份</button>
    </view>
  </view>

  <view wx:if="{{!loading && identityState === 'unbound'}}" class="section-card enrollment-card">
    <view class="section-title">新学长入塾申请</view>
    <view class="section-hint">公开申请只用于入塾审核，不会直接建立正式学员档案。</view>
    <button class="secondary-button" bindtap="openEnrollment">填写申请</button>
  </view>

  <view wx:if="{{!loading && member}}" class="entry-grid">
    <view class="entry-card" bindtap="openLearning">
      <view class="entry-icon">学</view>
      <view class="entry-title">我的学习</view>
      <view class="entry-copy">最近学习、参加记录和学分</view>
    </view>
    <view class="entry-card entry-card-primary" bindtap="openScan">
      <view class="entry-icon">扫</view>
      <view class="entry-title">扫码</view>
      <view class="entry-copy">参加活动或学习服务</view>
    </view>
    <view class="entry-card {{isVolunteer ? '' : 'entry-card-wide'}}" bindtap="openProfile">
      <view class="entry-icon">我</view>
      <view class="entry-title">我的成长</view>
      <view class="entry-copy">班级、小组和成长记录</view>
    </view>
    <view wx:if="{{isVolunteer}}" class="entry-card" bindtap="openServices">
      <view class="entry-icon">志</view>
      <view class="entry-title">志工服务</view>
      <view class="entry-copy">查看我当前承担的服务</view>
    </view>
  </view>

  <view wx:if="{{!loading && identityState === 'unbound'}}" class="entry-hint">绑定正式学员身份后，可使用学习、扫码和“我的成长”入口。</view>
  <view class="footer-copy">页面只显示与你当前身份相关的服务；暂未开放的功能会明确提示。</view>
</view>
