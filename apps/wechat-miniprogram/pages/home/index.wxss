.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #fbf7f3; color: #3d2a2a; }
.hero-card { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #741f2b, #a84c52); color: #fff; box-shadow: 0 16rpx 34rpx rgba(116, 31, 43, .18); }
.eyebrow { font-size: 24rpx; opacity: .82; letter-spacing: 2rpx; }
.hero-title { margin-top: 16rpx; font-size: 50rpx; font-weight: 700; }
.hero-copy { margin-top: 16rpx; line-height: 1.65; font-size: 27rpx; opacity: .92; }
.section-card, .state-card { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-hint, .identity-copy, .footer-copy { margin-top: 14rpx; color: #806f6f; line-height: 1.6; font-size: 25rpx; }
.identity-card { margin-top: 20rpx; padding: 24rpx; border-radius: 18rpx; background: #fff7f2; }
.identity-name { font-size: 34rpx; font-weight: 700; color: #741f2b; }
.identity-role { margin-top: 10rpx; color: #9a6b3b; font-size: 27rpx; font-weight: 600; }
.primary-button { margin-top: 22rpx; border-radius: 12rpx; background: #741f2b; color: #fff; font-size: 29rpx; }
.secondary-button { margin-top: 22rpx; border: 1rpx solid #c89579; border-radius: 12rpx; background: #fffaf7; color: #741f2b; font-size: 29rpx; }
.plain-button { margin-top: 12rpx; border: 1rpx solid #d9c7c3; border-radius: 12rpx; color: #741f2b; background: #fff; font-size: 27rpx; }
.entry-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 24rpx; }
.entry-card { width: calc(50% - 10rpx); min-height: 178rpx; box-sizing: border-box; margin-bottom: 20rpx; padding: 24rpx 22rpx; border: 1rpx solid #eadbd5; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.entry-card-primary { border-color: #c7837b; background: linear-gradient(145deg, #fff8f4, #fff0ec); }
.entry-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 18rpx; background: #f7e7df; color: #741f2b; font-size: 30rpx; font-weight: 700; }
.entry-card-primary .entry-icon { background: #741f2b; color: #fff; }
.entry-title { margin-top: 18rpx; color: #4c3030; font-size: 31rpx; font-weight: 700; }
.entry-copy { margin-top: 8rpx; color: #806f6f; font-size: 23rpx; line-height: 1.45; }
.entry-hint { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 18rpx; background: #fff; color: #806f6f; font-size: 25rpx; line-height: 1.55; text-align: center; }
.error { color: #b33b44; }
.footer-copy { padding: 22rpx 8rpx 40rpx; text-align: center; }
