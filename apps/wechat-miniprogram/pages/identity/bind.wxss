.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #f8f2ef; color: #3d2a2a; }
.hero-card { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #741f2b, #a84c52); color: #fff; box-shadow: 0 16rpx 34rpx rgba(116, 31, 43, .18); }
.eyebrow { font-size: 24rpx; opacity: .82; letter-spacing: 2rpx; }
.hero-title { margin-top: 16rpx; font-size: 46rpx; font-weight: 700; }
.hero-copy { margin-top: 16rpx; line-height: 1.65; font-size: 27rpx; opacity: .92; }
.section-card { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.field-row { margin-bottom: 24rpx; }
.field-label { margin-bottom: 12rpx; color: #5d4a4a; font-size: 28rpx; font-weight: 600; }
.field-input { box-sizing: border-box; width: 100%; padding: 20rpx; border: 1rpx solid #dfd0cc; border-radius: 12rpx; background: #fff; color: #3d2a2a; caret-color: #741f2b; font-size: 29rpx; }
.field-input-placeholder { color: #b7aaaa; }
.primary-button { margin-top: 20rpx; border-radius: 12rpx; background: #741f2b; color: #fff; font-size: 29rpx; }
.privacy-copy { padding: 28rpx 8rpx; color: #806f6f; line-height: 1.65; font-size: 24rpx; }
