<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">学习记录</view>
    <view class="hero-title">我的学习</view>
    <view wx:if="{{member}}" class="hero-copy">{{member.name_masked}}，这里记录你的学习服务与成长轨迹。</view>
    <view wx:else class="hero-copy">绑定正式学员身份后，可以查看与你相关的学习内容。</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在加载，请稍候…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <button wx:if="{{!loading && errorMessage}}" class="plain-button" bindtap="loadLearning">重新加载</button>

  <view wx:if="{{!loading && !member}}" class="section-card empty-card">
    <view class="section-title">先绑定身份</view>
    <view class="section-copy">绑定后才能看到属于自己的学习服务。</view>
    <button class="primary-button" bindtap="openBinding">绑定我的学员身份</button>
  </view>

  <block wx:if="{{!loading && member}}">
    <view class="section-card">
      <view class="section-title">当前学习服务</view>
      <view wx:if="{{currentLearningErrorMessage}}" class="empty-copy error">{{currentLearningErrorMessage}}</view>
      <view wx:if="{{currentLearning.length}}">
        <view wx:for="{{currentLearning}}" wx:key="uiKey" class="learning-row">
          <view class="learning-name">{{item.class_name}}<text wx:if="{{item.group_name}}"> · {{item.group_name}}</text></view>
          <view wx:if="{{item.cycle_index}}" class="learning-copy">{{item.plan_name}} · 第 {{item.cycle_index}} 学习周期 · {{item.status_name}}</view>
          <view wx:else class="learning-copy">{{item.status_name}}</view>
        </view>
        <button wx:if="{{canManageStudyMeeting}}" class="primary-button" bindtap="openStudyMeeting">进入学习会登记</button>
      </view>
      <view wx:elif="{{!currentLearningErrorMessage}}" class="empty-copy">暂无当前学习服务</view>
      <button wx:if="{{currentLearningErrorMessage}}" class="plain-button" bindtap="loadLearning">重新加载学习服务</button>
    </view>

    <view class="section-card">
      <view class="section-heading"><view class="section-title">最近学习</view><text wx:if="{{learningCount !== null}}" class="record-count">累计 {{learningCount}}次</text></view>
      <view class="learning-copy">学习会、班级学习日、小组学习会、开班和课程</view>
      <view wx:if="{{historyErrorMessage}}" class="empty-copy error">{{historyErrorMessage}}</view>
      <view wx:elif="{{recentLearning.length}}">
        <view wx:for="{{recentLearning}}" wx:key="uiKey" class="learning-row">
          <view class="learning-name">{{item.title}}</view>
          <view class="learning-copy">{{item.occurredAtLabel}} · {{item.learning_type}}<text wx:if="{{item.status_name}}"> · {{item.status_name}}</text></view>
          <view wx:if="{{item.scopeLabel}}" class="learning-copy">{{item.scopeLabel}}</view>
        </view>
      </view>
      <view wx:else class="empty-copy">暂无学习记录</view>
      <button class="plain-button" bindtap="openLearningHistory">查看全部学习记录</button>
    </view>

    <view class="section-card">
      <view class="section-title">我的学分</view>
      <view wx:if="{{creditErrorMessage}}" class="empty-copy error">{{creditErrorMessage}}</view>
      <block wx:elif="{{creditSummary}}">
        <view class="credit-total">{{creditSummary.totalPointsLabel}}</view>
        <view class="learning-copy">本年度（{{creditSummary.current_year}}年）已入账 {{creditSummary.currentYearPointsLabel}}</view>
        <view class="learning-copy">标准学习 {{creditSummary.standardPointsLabel}} · 拓展活动 {{creditSummary.extensionPointsLabel}}</view>
        <view wx:if="{{creditEntries.length}}">
          <view wx:for="{{creditEntries}}" wx:key="uiKey" class="learning-row credit-entry">
            <view class="learning-name">{{item.credit_type_label}}</view>
            <view class="learning-copy">{{item.period_display}} · {{item.credit_category_label}}</view>
            <view class="learning-copy">依据：{{item.rule_basis}}</view>
            <view class="credit-points">{{item.pointsLabel}}</view>
          </view>
        </view>
        <view wx:else class="empty-copy">暂无正式入账记录。待审批或未入账提案不会计入总分。</view>
        <button class="plain-button" bindtap="openCreditHistory">全部学分记录与详情</button>
      </block>
    </view>
  </block>

  <button class="plain-button home-button" bindtap="backHome">返回首页</button>
</view>
