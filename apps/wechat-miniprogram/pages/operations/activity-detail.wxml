<view class="page-shell">
  <view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">{{eventId ? '活动现场管理' : '创建活动'}}</view><view class="hero-copy">{{eventId ? title : '手机安排活动，现场处理报名与签到'}}</view></view>
  <view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}<button class="plain-button" bindtap="load">重新加载</button></view>
  <block wx:if="{{!loading && !errorMessage}}">
    <view wx:if="{{sessions.length > 1 || statistics.isClassMeeting}}" class="session-tabs"><button wx:if="{{statistics.isClassMeeting}}" data-id="overall" class="session-tab {{statisticsScope === 'overall' ? 'selected' : ''}}" disabled="{{saving || adding}}" bindtap="switchSession">整体</button><button wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" class="session-tab {{eventId === item.id && (!statistics.isClassMeeting || statisticsScope !== 'overall') ? 'selected' : ''}}" disabled="{{saving || adding}}" bindtap="switchSession">{{item.session_name || item.title}}</button></view>
    <view wx:if="{{statistics}}" class="section-card">
      <view class="section-title">{{statistics.isClassMeeting ? '本次班会参会统计' : '当前场次统计'}}</view>
      <block wx:if="{{statistics.isClassMeeting}}">
        <view class="metric-grid"><view><view class="muted">{{statistics.scopeLabel}}参会率（含本班师资）</view><view class="metric">{{statistics.overallRate}}</view><view class="muted">{{statistics.overallPresent}} / {{statistics.rosterCount}} 人</view></view><view><view class="muted">总小组参会率</view><view class="metric">{{statistics.groupRate}}</view></view></view>
        <view class="muted">在册学长到场 {{statistics.memberPresent}} 人，额外师资 {{statistics.staffPresent}} 人。{{statistics.basis}}</view>
        <view wx:for="{{groupRows}}" wx:key="group_id" class="group-row"><view>{{item.group_name}}</view><view>{{item.present_count}} / {{item.roster_count}} 人</view><view>{{item.rateLabel}}</view></view>
      </block>
      <view wx:if="{{!statistics.isClassMeeting || statisticsScope !== 'overall'}}" class="row"><text>{{statistics.isClassMeeting ? '本场在册学长到场 / 应参' : '当前场次签到 / 报名'}}</text><text>{{statistics.sessionChecked}} / {{statistics.sessionTotal}}</text></view><view wx:if="{{!statistics.isClassMeeting || statisticsScope !== 'overall'}}" class="row"><text>当前场次现场真人数</text><text>{{statistics.onsite}}</text></view><view wx:if="{{statistics.message}}" class="error">{{statistics.message}}</view>
    </view>
    <view wx:if="{{statistics.isClassMeeting && statisticsScope === 'overall'}}" class="section-card muted">请选择上午、下午或空巴，管理对应场次的活动安排、报名及签到。</view>
    <block wx:if="{{!eventId || !statistics.isClassMeeting || statisticsScope !== 'overall'}}">
    <view class="section-card">
      <view class="section-title">活动安排</view>
      <picker wx:if="{{!eventId}}" range="{{activityTypes}}" range-key="label" value="{{typeIndex}}" bindchange="chooseType"><view class="field">{{activityTypes[typeIndex].label}} ›</view></picker>
      <input class="field" placeholder="活动名称" value="{{title}}" data-field="title" bindinput="input" maxlength="500" disabled="{{eventId && !detail.can_update}}"/>
      <picker mode="date" value="{{eventDate}}" bindchange="chooseDate" disabled="{{eventId && !detail.can_edit_times}}"><view class="field">日期 {{eventDate}} ›</view></picker>
      <block wx:if="{{!eventId && activityType === 'class_meeting'}}">
        <picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="chooseClass"><view class="field">{{classes[classIndex].name || '选择班级'}} ›</view></picker><view class="muted">当前在册 {{classes[classIndex].member_count || 0}} 人。创建时自动读取最新名单并确认上午、下午、空巴三场。</view>
        <view wx:for="{{periods}}" wx:for-item="period" wx:key="key" class="period-card"><view class="section-title">{{period.label}}</view><view class="time-grid"><picker wx:for="{{clockFields}}" wx:for-item="clock" wx:key="key" mode="time" value="{{classTimes[period.key + '_' + clock.key]}}" data-field="{{period.key + '_' + clock.key}}" bindchange="chooseTime"><view class="field"><view class="muted">{{clock.label}}</view>{{classTimes[period.key + '_' + clock.key]}} ›</view></picker></view></view>
      </block>
      <block wx:else>
        <picker wx:if="{{!eventId}}" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="chooseOrg"><view class="field">{{organizations[orgIndex].name || '选择活动组织'}} ›</view></picker>
        <view class="muted">北京时间 · 当前场次签到时间</view><view class="time-grid"><picker mode="time" value="{{checkinStart}}" data-field="checkinStart" bindchange="chooseTime" disabled="{{eventId && !detail.can_edit_times}}"><view class="field">开放 {{checkinStart}} ›</view></picker><picker mode="time" value="{{checkinEnd}}" data-field="checkinEnd" bindchange="chooseTime" disabled="{{eventId && !detail.can_edit_times}}"><view class="field">截止 {{checkinEnd}} ›</view></picker></view>
        <view wx:if="{{!eventId}}" class="muted">保存为活动草稿，核对信息后确认活动。</view>
      </block>
      <view wx:if="{{eventId}}" class="muted">{{status === 'CONFIRMED' ? '已确认' : status === 'CANCELLED' ? '已取消' : '草稿'}} · {{detail.group.session_name || '活动现场'}} · {{detail.group.checkin_status === 'open' ? '签到开放' : detail.group.checkin_status === 'upcoming' ? '签到未开始' : '签到已关闭'}}</view>
      <button wx:if="{{!eventId || detail.can_update}}" class="primary-button" loading="{{saving}}" disabled="{{saving || adding}}" bindtap="save">{{eventId ? '保存当前场次信息' : activityType === 'class_meeting' ? '创建并确认三场班会' : '创建活动草稿'}}</button>
      <button wx:if="{{detail.can_manage || detail.can_update}}" class="plain-button" disabled="{{saving || adding}}" bindtap="changeStatus">确认 / 管理活动状态</button>
      <button wx:if="{{detail.can_manage && status !== 'CANCELLED'}}" class="plain-button" disabled="{{saving || adding}}" bindtap="setCheckinState">开放 / 关闭当前场次签到</button>
      <button wx:if="{{detail.can_sync_roster && detail.group.activity_type === 'class_meeting' && status !== 'CANCELLED'}}" class="plain-button" disabled="{{saving || adding}}" bindtap="syncRoster">增补可信班级名单</button>
      <button wx:if="{{detail.can_code && status === 'CONFIRMED'}}" class="plain-button" disabled="{{saving || adding}}" bindtap="showCode">显示当前场次签到码</button>
      <view wx:if="{{codePath}}" class="entry-code"><image src="{{codePath}}" mode="widthFix"/><view class="muted">{{detail.group.session_name || title}} · 请核对场次后扫码</view></view>
    </view>
    <view wx:if="{{detail.can_manage && status !== 'CANCELLED' && (detail.group.checkin_status === 'open' || detail.group.checkin_status === 'upcoming')}}" class="section-card"><view class="section-title">现场新增临时参加人员</view><input class="field" placeholder="临时参加人员姓名" value="{{personName}}" data-field="personName" bindinput="input" maxlength="255"/><input class="field" placeholder="手机号码（选填，用于核对在册身份）" value="{{personPhone}}" data-field="personPhone" bindinput="input" type="number" maxlength="11"/><view class="muted">加入当前场次报名名单后，可按现场规则扫码或人工签到。</view><button class="primary-button" loading="{{adding}}" disabled="{{adding || saving}}" bindtap="addAttendee">保存临时报名</button></view>
    <view wx:if="{{detail}}" class="section-card"><view class="section-title">当前场次报名与参加明细</view><input class="field" placeholder="搜索姓名、单位或小组" value="{{keyword}}" bindinput="search"/><view wx:if="{{!people.length}}" class="muted">暂无匹配人员</view><view wx:for="{{people}}" wx:key="registration_id" class="person-row"><view class="person-info"><view>{{item.displayName}}</view><view class="muted">{{item.current_group_name || item.group_name || '未分组'}} · {{item.statusLabel}}</view><view wx:if="{{item.actual_attendee_name && item.actual_attendee_name !== item.displayName}}" class="muted">实际参加：{{item.actual_attendee_name}}</view></view><button wx:if="{{item.hasActions}}" size="mini" class="person-action" data-id="{{item.registration_id}}" disabled="{{saving || adding}}" bindtap="managePerson">处理</button></view></view>
    </block>
  </block>
</view>
