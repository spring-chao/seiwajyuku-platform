<view class="page-shell"><view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">{{eventId ? '活动详情' : '创建活动'}}</view><view class="hero-copy">沿用现场活动与签到管理</view></view><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && !errorMessage}}">
    <view class="section-card"><view class="section-title">活动安排</view><input class="field" placeholder="活动名称" value="{{title}}" data-field="title" bindinput="input" maxlength="500" disabled="{{eventId && !detail.can_update}}"/><picker mode="date" value="{{eventDate}}" bindchange="chooseDate" disabled="{{eventId && !detail.can_update}}"><view class="field">{{eventDate}} ›</view></picker>
      <block wx:if="{{!eventId}}"><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="chooseOrg"><view class="field">{{organizations[orgIndex].name || '选择活动组织'}} ›</view></picker><view class="muted">北京时间 · 签到开放与截止</view><picker mode="time" value="{{checkinStart}}" data-field="checkinStart" bindchange="chooseTime"><view class="field">开放 {{checkinStart}} ›</view></picker><picker mode="time" value="{{checkinEnd}}" data-field="checkinEnd" bindchange="chooseTime"><view class="field">截止 {{checkinEnd}} ›</view></picker><view class="muted">创建后为草稿，核对后确认活动。班级学习会及小组学习会沿用专用入口安排。</view></block>
      <view wx:if="{{eventId}}" class="muted">状态：{{status === 'CONFIRMED' ? '已确认' : status === 'CANCELLED' ? '已取消' : '草稿'}} · {{detail.group.session_name || '活动现场'}}</view><button wx:if="{{!eventId || detail.can_update}}" class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{eventId ? '保存活动信息' : '创建活动草稿'}}</button><button wx:if="{{detail.can_manage || detail.can_update}}" class="plain-button" disabled="{{saving}}" bindtap="changeStatus">确认 / 管理活动状态</button>
    </view>
    <view wx:if="{{detail.can_manage && status !== 'CANCELLED'}}" class="section-card"><view class="section-title">现场新增临时参加人员</view><input class="field" placeholder="临时参加人员姓名" value="{{personName}}" data-field="personName" bindinput="input" maxlength="255"/><input class="field" placeholder="手机号码（选填，用于核对在册身份）" value="{{personPhone}}" data-field="personPhone" bindinput="input" type="number" maxlength="11"/><view class="muted">保存后加入本场报名名单，参加人员仍按现场规则扫码签到。</view><button class="primary-button" loading="{{adding}}" disabled="{{adding}}" bindtap="addAttendee">保存临时报名</button></view>
    <view wx:if="{{detail}}" class="section-card"><view class="section-title">报名与参加明细</view><view wx:if="{{!detail.attendees.length}}" class="muted">暂无报名人员</view><view wx:for="{{detail.attendees}}" wx:key="registration_id" class="row"><text>{{item.registered_display_name || item.registered_name || item.name}}</text><text>{{item.checked || item.checked_at ? '已签到' : '未签到'}}</text></view></view>
  </block>
</view>
