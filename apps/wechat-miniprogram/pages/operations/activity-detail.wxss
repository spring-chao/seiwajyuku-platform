@import "./shared.wxss";
.session-tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.session-tab{min-height:76rpx;line-height:76rpx;flex:1;min-width:180rpx;margin:0;padding:0 12rpx;font-size:26rpx;border-radius:14rpx;background:#fff;color:#741f2b}.session-tab.selected{background:#741f2b;color:#fff}.time-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12rpx}.time-grid .field{margin:8rpx 0;font-size:26rpx}.time-grid .muted{margin-top:0}.period-card{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #eee}.period-card .section-title{font-size:28rpx;margin-bottom:8rpx}.metric-grid{margin:0 0 20rpx;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.metric{font-size:44rpx}.group-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #f5eeeb;font-size:26rpx}.person-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #f5eeeb}.person-info{flex:1;min-width:0;overflow-wrap:break-word;font-size:29rpx}.person-action{width:auto;flex-shrink:0;margin:0;color:#741f2b;background:#f8f2ef;font-size:25rpx}.entry-code{text-align:center;margin-top:24rpx}.entry-code image{width:360rpx;max-width:100%}
