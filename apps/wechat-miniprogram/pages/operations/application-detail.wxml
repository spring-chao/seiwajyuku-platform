<view class="page-shell"><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view><block wx:if="{{!loading && detail}}">
  <view class="hero-card"><view class="eyebrow">入塾申请</view><view class="hero-title">{{detail.application.name}}</view><view class="hero-copy">{{statusLabel}} · {{detail.application.application_no}}</view></view>
  <view class="section-card"><view class="section-title">申请资料</view><view class="row"><text>申请加入</text><text>{{detail.application.target_shuku_name || '待确认'}}</text></view><view class="row"><text>联系方式</text><text>{{detail.application.phone_masked}}</text></view><view class="row"><text>企业</text><text>{{detail.application.company_name}}</text></view><view class="row"><text>职位</text><text>{{detail.application.position}}</text></view><view class="row"><text>介绍人</text><text>{{detail.application.referrer}}</text></view><view class="row"><text>生日</text><text>{{detail.application.birthday}}</text></view><view class="row"><text>管理组织</text><text>{{detail.application.org_unit_name || '待分配'}}</text></view><view class="row"><text>收款状态</text><text>{{detail.application.payment_status === 'PAID' ? '已确认收款' : '待确认'}}</text></view><view wx:if="{{detail.application.duplicate_member_risk}}" class="error">存在重复学员风险，请先核实。</view><button wx:if="{{detail.actions.export}}" class="plain-button" loading="{{exporting}}" disabled="{{exporting}}" bindtap="saveImage">保存申请摘要图片</button></view>
  <view wx:if="{{detail.actions.review && detail.application.application_status !== 'ENROLLED' && detail.application.application_status !== 'CANCELLED'}}" class="section-card"><view class="section-title">核对与审核</view><input class="field" placeholder="姓名" value="{{name}}" data-field="name" bindinput="input"/><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="chooseOrg"><view class="field">{{orgIndex >= 0 ? organizations[orgIndex].name : '选择管理组织'}} ›</view></picker><picker mode="date" value="{{joinDate}}" bindchange="chooseDate"><view class="field">{{joinDate || '选择入塾日期'}} ›</view></picker><textarea class="copy-editor" placeholder="审核备注 / 驳回原因" value="{{note}}" data-field="note" bindinput="input" maxlength="2000"/><button class="plain-button" disabled="{{saving}}" data-decision="SAVE" bindtap="review">保存核对资料</button><button class="primary-button" disabled="{{saving}}" data-decision="APPROVE" bindtap="review">审核通过</button><button class="plain-button" disabled="{{saving}}" bindtap="reject">驳回申请</button></view>
  <view wx:if="{{detail.actions.payment && detail.application.payment_status !== 'PAID' && detail.application.application_status !== 'ENROLLED' && detail.application.application_status !== 'REJECTED' && detail.application.application_status !== 'CANCELLED'}}" class="section-card"><view class="section-title">确认收款</view><input class="field" type="digit" placeholder="实际收款金额（元）" value="{{amount}}" data-field="amount" bindinput="input"/><button class="primary-button" disabled="{{saving}}" bindtap="confirmPayment">确认已收款</button></view>
  <view wx:if="{{detail.actions.enroll && detail.application.application_status !== 'ENROLLED'}}" class="section-card"><view class="section-title">正式入塾</view><view wx:for="{{detail.application.missing_gates}}" wx:key="*this" class="error">{{item}}</view><button class="primary-button" disabled="{{saving || !detail.application.can_enroll}}" bindtap="enroll">确认正式入塾</button></view>
</block><canvas canvas-id="applicationSummary" class="export-canvas" style="width:640px;height:{{canvasHeight}}px"/></view>
