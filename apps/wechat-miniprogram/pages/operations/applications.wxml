<view class="page-shell"><view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">待入塾申请</view><view class="hero-copy">资料审核、收款确认与正式入塾</view></view><view class="section-card"><input class="field" placeholder="姓名 / 申请编号 / 手机号后4位" value="{{keyword}}" bindinput="input" bindconfirm="load"/><picker range="{{filters}}" range-key="label" value="{{filterIndex}}" bindchange="chooseFilter"><view class="field">{{filters[filterIndex].label}} ›</view></picker><button class="plain-button" bindtap="load">查询</button></view><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view><view wx:if="{{!loading && !errorMessage && !records.length}}" class="section-card">暂无符合条件的申请。</view><view wx:for="{{records}}" wx:key="id" class="section-card" data-id="{{item.id}}" bindtap="open"><view class="section-title">{{item.name}} · {{item.statusLabel}}</view><view>{{item.company_name}}</view><view class="muted">{{item.application_no}} · {{item.phone_masked}}</view><view class="muted">{{item.target_shuku_name || '待确认申请塾'}} · {{item.payment_status === 'PAID' ? '已收款' : '待确认收款'}}</view><view class="go-copy">查看与处理 ›</view></view></view>
