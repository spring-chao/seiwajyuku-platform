.page-shell{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy{margin-top:16rpx;line-height:1.65;font-size:27rpx}.section-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.field-label{font-size:29rpx;font-weight:700}.next-label{margin-top:28rpx}.picker-field{display:flex;justify-content:space-between;margin-top:18rpx;padding:20rpx 0;border-bottom:1rpx solid #eadeda;color:#806f6f;font-size:28rpx}.field-textarea{box-sizing:border-box;width:100%;height:220rpx;margin-top:18rpx;padding:18rpx;border:1rpx solid #dfd0cc;border-radius:12rpx;font-size:28rpx}.field-textarea.short{height:140rpx}.primary-button{margin-top:30rpx;border-radius:12rpx;background:#741f2b;color:#fff}
