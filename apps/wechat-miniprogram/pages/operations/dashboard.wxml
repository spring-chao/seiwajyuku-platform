<view class="page-shell"><view class="hero-card"><view class="eyebrow">数据概览</view><view class="hero-title">运营驾驶舱</view><view class="hero-copy">{{snapshot.scope_label || '当前授权范围'}} · 看见进展，安排下一步行动</view></view><picker mode="date" fields="month" value="{{month}}" bindchange="chooseMonth"><view class="section-card">{{month}}　切换月份 ›</view></picker><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && snapshot}}"><view class="metric-grid"><view wx:for="{{metrics}}" wx:key="key" class="metric-card"><view class="metric">{{item.value}}</view><view class="muted">{{item.label}}</view></view></view>
    <view class="section-card"><view class="section-title">分中心在册分布</view><view wx:for="{{snapshot.centers}}" wx:key="id" class="row"><text>{{item.name}}</text><text>{{item.active_member_count}} 人</text></view><view wx:if="{{!snapshot.centers.length}}" class="muted">当前范围暂无分中心数据</view></view>
    <view class="section-card"><view class="section-title">本月生日</view><view wx:if="{{!snapshot.birthday_members.length}}" class="muted">本月暂无生日学长</view><view wx:for="{{snapshot.birthday_members}}" wx:key="member_id" class="row" data-item="{{item}}" bindtap="openBirthday"><text>{{item.name}}</text><text>{{item.birthday}} ›</text></view></view>
    <view class="section-card"><view class="section-title">班会与活动安排</view><view wx:for="{{snapshot.class_meeting_schedule}}" wx:key="class_org_unit_id" class="field"><view>{{item.class_name}}</view><view class="muted">{{item.event_date || '本月未排期'}} · {{item.title}}</view></view><view wx:for="{{snapshot.activities}}" wx:key="id" class="field">{{item.event_date}} · {{item.title}}</view><button class="plain-button" bindtap="openMeetings">查看小组学习会参会率</button><button class="plain-button" bindtap="openActivities">进入活动管理</button></view>
    <view class="section-card"><view class="section-title">数据口径与待完善</view><view class="muted">在册人数为当前状态；新增、续费和活动为所选月份的事实。未授权或未接入的数据以“—”或说明展示。</view><view class="muted">缺少入塾日期 {{snapshot.data_quality.missing_join_date_count}} 人 · 未排期班级 {{snapshot.data_quality.unscheduled_class_count}} 个</view><view wx:for="{{snapshot.data_quality.notes}}" wx:key="*this" class="muted">{{item}}</view></view>
  </block>
</view>
