<view class="page-shell"><view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">关怀跟进</view><view class="hero-copy">只可查看并记录当前任务参与人允许的服务过程。</view></view><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view><view wx:for="{{tasks}}" wx:key="id" class="section-card {{selectedTaskId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose"><view class="section-title">{{item.member_name}} · {{item.task_type}}</view><view>{{item.service_purpose}}</view><view class="muted">{{item.org_name}} · {{item.status}}</view><view wx:if="{{!item.can_record}}" class="muted">当前不是该任务可记录的服务参与人</view></view><view wx:if="{{selectedTaskId}}" class="section-card"><view class="section-title">记录本次跟进</view><textarea class="textarea" data-field="facts" bindinput="input" value="{{facts}}" placeholder="客观事实（必填）"/><textarea class="textarea" data-field="nextAction" bindinput="input" value="{{nextAction}}" placeholder="下一步行动（可选）"/><button class="primary-button" loading="{{saving}}" bindtap="submit">提交跟进记录</button></view></view>
