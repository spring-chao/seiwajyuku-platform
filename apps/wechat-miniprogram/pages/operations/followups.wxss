.page-shell{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy,.muted{margin-top:16rpx;line-height:1.65;font-size:27rpx}.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{font-size:32rpx;font-weight:700}.selected{outline:3rpx solid #741f2b}.muted{color:#806f6f;font-size:24rpx}.textarea{box-sizing:border-box;width:100%;min-height:150rpx;margin-top:16rpx;padding:16rpx;border:1rpx solid #dfd0cc;border-radius:12rpx}.primary-button{margin-top:20rpx;border-radius:12rpx;background:#741f2b;color:#fff}.error{color:#a42b34}
