.page-shell { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background:#f8f2ef; color:#3d2a2a; }
.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}
.eyebrow{font-size:24rpx;opacity:.82}.hero-title{margin-top:16rpx;font-size:42rpx;font-weight:700}.hero-copy,.entry-copy{margin-top:16rpx;line-height:1.65;font-size:27rpx}
.count-card{display:flex;margin-top:24rpx;padding:26rpx;border-radius:24rpx;background:#fff}.count-item{flex:1;text-align:center;color:#806f6f;font-size:25rpx}.count-number{margin-bottom:8rpx;color:#741f2b;font-size:46rpx;font-weight:700}.count-divider{width:1rpx;background:#eadeda}
.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{font-size:32rpx;font-weight:700}.entry{position:relative}.entry-arrow{position:absolute;right:28rpx;top:36rpx;color:#741f2b}.error{color:#a42b34}
