.page-shell{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy,.muted{margin-top:16rpx;line-height:1.65;font-size:27rpx}.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{margin-bottom:12rpx;font-size:32rpx;font-weight:700}.row{display:flex;justify-content:space-between;margin-top:16rpx;color:#806f6f;font-size:26rpx}.row text{color:#3d2a2a;text-align:right}.muted{color:#806f6f;font-size:24rpx}.role-row{margin-top:14rpx;font-size:26rpx}.contact-card{background:#fff9f7}.contact-phone{margin-top:18rpx;font-size:38rpx;font-weight:700;letter-spacing:2rpx}.action-bar{display:flex;gap:18rpx;margin:28rpx 0}.primary-button,.plain-button{flex:1;margin:0;border-radius:12rpx}.primary-button{background:#741f2b;color:#fff}.plain-button{color:#741f2b;background:#fff;border:1rpx solid #741f2b}.error{color:#a42b34}
