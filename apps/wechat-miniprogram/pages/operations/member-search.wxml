<view class="page-shell">
  <view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">学长查询</view><view class="hero-copy">姓名或手机号后4位；查询范围始终服从当前组织授权。</view></view>
  <view wx:if="{{careMode}}" class="hint-card">选择学长后，即可记录一次关爱。</view>
  <view class="section-card"><input class="field-input" value="{{keyword}}" bindinput="handleInput" confirm-type="search" bindconfirm="search" placeholder="姓名或手机号后4位"/><button class="primary-button" loading="{{loading}}" bindtap="search">查询</button></view>
  <view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <view wx:if="{{!loading && !errorMessage && keyword && !results.length}}" class="state-card">没有找到当前授权范围内的学长。</view>
  <view wx:for="{{results}}" wx:key="member_id" class="section-card result-card" data-member-id="{{item.member_id}}" bindtap="openMember">
    <view class="section-title">{{item.name}}</view>
    <view>{{item.class_name || item.org_name || '当前组织待确认'}}</view>
    <view class="muted">入塾时间：{{item.join_date || '待维护'}}</view>
    <view class="muted">续费状态：{{item.renewal.status_label || '当前无权查看'}}</view>
  </view>
</view>
