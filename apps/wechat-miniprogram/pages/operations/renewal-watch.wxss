.page-shell{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy,.muted{margin-top:16rpx;line-height:1.65;font-size:27rpx}.tabs{display:flex;margin-top:24rpx;padding:8rpx;border-radius:20rpx;background:#fff}.tab{flex:1;padding:18rpx 6rpx;border-radius:14rpx;text-align:center;color:#806f6f;font-size:29rpx}.tab.active{background:#741f2b;color:#fff}.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{font-size:32rpx;font-weight:700}.muted{color:#806f6f;font-size:24rpx}.go-copy{margin-top:18rpx;color:#741f2b;font-size:26rpx}.renewal-card{border:1rpx solid transparent}.renewal-card.focused{border-color:#741f2b}.error{color:#a42b34}
