.page-shell{min-height:100vh;padding:28rpx 28rpx 64rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy{margin-top:16rpx;line-height:1.65;font-size:27rpx}.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{margin-bottom:16rpx;font-size:32rpx;font-weight:700}.muted{margin-top:12rpx;line-height:1.65;color:#806f6f;font-size:25rpx}.row{display:flex;justify-content:space-between;gap:28rpx;padding:16rpx 0;border-bottom:1rpx solid #f5eeeb;line-height:1.6;font-size:27rpx}.row text:last-child{text-align:right;flex:1}.field{margin:18rpx 0;padding:22rpx 18rpx;background:#f8f2ef;border-radius:12rpx;min-height:42rpx;line-height:1.6;font-size:28rpx}input.field{height:56rpx}.primary-button,.plain-button{margin:24rpx 0 0;border-radius:14rpx;font-size:28rpx}.primary-button{background:#741f2b;color:#fff}.plain-button{color:#741f2b;background:#fff;border:1rpx solid #dbc4c5}.error{color:#a42b34;line-height:1.8;font-size:27rpx}.go-copy{margin-top:18rpx;color:#741f2b;font-size:27rpx}.metric{color:#741f2b;font-size:48rpx;font-weight:700;margin-top:16rpx}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx}.metric-card{padding:22rpx 28rpx;border-radius:22rpx;background:#fff}.copy-editor{width:100%;box-sizing:border-box;margin:24rpx 0;padding:20rpx;border-radius:12rpx;background:#f8f2ef;font-size:28rpx;line-height:1.8;min-height:180rpx}.export-canvas{position:fixed;left:-10000px;top:0;pointer-events:none}
