<view class="page-shell"><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view><view wx:if="{{resultMessage}}" class="section-card">{{resultMessage}}</view>
  <block wx:if="{{!loading && detail}}">
    <view class="hero-card"><view class="eyebrow">学习会明细</view><view class="hero-title">{{detail.record.group_name}}</view><view class="hero-copy">{{detail.record.class_name}} · {{detail.record.meeting_date}}</view></view>
    <view class="section-card"><view class="section-title">参会率 {{detail.participation.rate === null ? '—' : detail.participation.rate + '%'}}</view><view>本组 {{detail.participation.home_present_count}} / {{detail.participation.roster_count}} 人 · 跨组 {{detail.participation.cross_group_count}} 人</view><view class="muted">{{detail.participation.basis}}</view><button wx:if="{{detail.record.evidence}}" bindtap="viewPhoto" class="plain-button">查看学习合影</button><view wx:else class="muted">合影缺失或已过保存期限</view></view>
    <view class="section-card"><view class="section-title">核实与入账状态</view><view>{{detail.record.review_status === 'CONFIRMED' ? '已核实' : '待核实'}} · {{detail.record.credit_settlement.status}}</view><view class="muted">已入账 {{detail.record.credit_settlement.posted_points}} 分 · 待核对归组 {{detail.participation.unresolved_count}} 人</view><view wx:if="{{detail.record.credit_settlement.message}}" class="error">{{detail.record.credit_settlement.message}}</view></view><view class="section-card"><view class="section-title">参会人员</view><view wx:for="{{detail.record.attendees}}" wx:key="member_id" class="row"><text>{{item.name}}</text><text>{{item.current_attendance_type === 'HOME_GROUP' ? '本组' : item.current_attendance_type === 'UNRESOLVED' ? '归组待核对' : '跨组 · ' + item.current_group_name}}</text></view></view>
    <view class="section-card"><view class="section-title">本组未参会人员</view><view wx:if="{{!detail.participation.absent.length}}" class="muted">暂无未参会人员</view><view wx:for="{{detail.participation.absent}}" wx:key="member_id" class="row">{{item.name}}</view></view>
    <view class="section-card"><view class="section-title">课程完成明细</view><view wx:if="{{!detail.record.courses.length}}" class="muted">本场未登记课程</view><view wx:for="{{detail.record.courses}}" wx:key="course_key" wx:for-item="course"><view class="field">{{course.course_name_snapshot}}</view><view wx:for="{{course.completions}}" wx:key="member_id" class="row"><text>{{item.member_name}}</text><text>{{item.completion_status === 'CONFIRMED' ? '已确认完成' : item.completion_status === 'NOT_COMPLETED' ? '未完成' : '待确认'}}</text></view></view></view>
    <view wx:if="{{detail.preview}}" class="section-card"><view class="section-title">学分结算预览</view><view>本次可结算 {{detail.preview.totals.proposed_points}} 分 · {{detail.preview.totals.proposed_entry_count}} 项</view><view class="muted">已入账 {{detail.preview.totals.duplicate_entry_count}} 项 · 受阻 {{detail.preview.totals.blocked_entry_count}} 项</view><view wx:for="{{detail.preview.blocking_reasons}}" wx:key="*this" class="error">{{item}}</view><view class="muted" wx:if="{{!detail.settlement_enabled}}">正式结算开关尚未开启，核实结果可保存，结算结果将单独提示</view><button wx:if="{{detail.can_settle}}" class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="verifySettle">核实确认并自动结算</button></view>
  </block>
</view>
