<view class="page-shell"><view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">小组学习会</view><view class="hero-copy">参会率与人员明细 · 核实并结算</view></view>
  <picker mode="date" fields="month" value="{{month}}" bindchange="chooseMonth"><view class="section-card">{{month}}　选择月份 ›</view></picker>
  <view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{errorMessage}}" class="state-card error">{{errorMessage}}</view><view wx:if="{{!loading && !errorMessage && !records.length}}" class="section-card">本月暂无学习会记录。</view>
  <view wx:for="{{records}}" wx:key="id" class="section-card" data-id="{{item.id}}" bindtap="openRecord"><view class="section-title">{{item.class_name}} · {{item.group_name}}</view><view>{{item.meeting_date}} · {{item.status === 'SUBMITTED' ? '已提交' : item.status === 'DRAFT' ? '草稿' : '已取消'}}</view><view class="metric">{{item.participation.rate === null ? '—' : item.participation.rate + '%'}} <text class="muted">本组参会率</text></view><view class="muted">本组 {{item.participation.home_present_count}} / {{item.participation.roster_count}} 人 · 跨组 {{item.participation.cross_group_count}} 人</view><view class="go-copy">查看明细与结算 ›</view></view>
</view>
