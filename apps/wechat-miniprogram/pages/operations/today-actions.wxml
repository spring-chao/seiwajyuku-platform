<view class="page-shell"><view class="hero-card"><view class="eyebrow">移动运营</view><view class="hero-title">今日行动</view><view class="hero-copy">按当前组织授权实时显示的待办。</view></view><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view><view wx:if="{{!loading && !errorMessage && !items.length}}" class="section-card">今天暂无待办。</view><view wx:for="{{items}}" wx:key="id" class="section-card"><view class="section-title">{{item.member_name}} · {{item.source}}</view><view>{{item.label}}</view><view class="muted">{{item.due_date || '时间待确认'}} · {{item.status || ''}}</view><button wx:if="{{item.source === '关怀任务' && item.can_record}}" class="plain-button" data-item="{{item}}" bindtap="openFollowup">记录跟进</button></view></view>
