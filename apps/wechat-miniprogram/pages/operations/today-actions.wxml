<view class="page-shell">
  <view class="hero-card"><view class="hero-title">今日行动</view></view>
  <view wx:if="{{!loading && !errorMessage}}" class="tab-card">
    <view class="tab {{activeTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="showTab">今日待处理 {{summary.pending_action_count || 0}}</view>
    <view class="tab {{activeTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="showTab">今日已完成 {{summary.completed_action_count || 0}}</view>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在加载…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <template name="anniversaryItem">
    <view class="anniversary-item" data-id="{{item.member_id}}" data-due="{{item.due_date}}" bindtap="openAnniversary">
      <view class="action-head">
        <view class="anniversary-name">{{item.member_name}}学长 · {{item.years}} 周年</view>
        <view class="type-tag">{{item.send_status === 'SENT' ? '已发送' : item.review_status === 'APPROVED' ? '待发送' : '待生成'}}</view>
      </view>
      <view class="anniversary-meta">
        <text>{{item.class_name || item.org_name}} · {{item.sent_date || item.due_date}}</text>
        <text class="action-link">{{item.send_status === 'SENT' ? '查看记录 ›' : '准备祝福 ›'}}</text>
      </view>
    </view>
  </template>
  <view wx:if="{{!loading && !errorMessage && activeTab === 'pending' && (anniversaries.length || upcomingAnniversaries.length)}}" class="section-card">
    <view class="section-title">入塾周年关怀</view>
    <block wx:for="{{anniversaries}}" wx:key="member_id"><template is="anniversaryItem" data="{{item: item}}" /></block>
    <view wx:if="{{upcomingAnniversaries.length}}" class="muted">未来 7 天 · 可提前准备</view>
    <block wx:for="{{upcomingAnniversaries}}" wx:key="member_id"><template is="anniversaryItem" data="{{item: item}}" /></block>
  </view>
  <view wx:if="{{!loading && !errorMessage && activeTab === 'completed' && completedAnniversaries.length}}" class="section-card">
    <view class="section-title">入塾周年关怀</view>
    <block wx:for="{{completedAnniversaries}}" wx:key="member_id"><template is="anniversaryItem" data="{{item: item}}" /></block>
  </view>
  <view wx:if="{{!loading && !errorMessage && !items.length && !(activeTab === 'pending' ? anniversaries.length || upcomingAnniversaries.length : completedAnniversaries.length)}}" class="section-card">{{activeTab === 'pending' ? '今天暂无待处理行动。' : '今天还没有已完成行动。'}}</view>
  <view wx:for="{{items}}" wx:key="id" class="section-card action-card" data-item="{{item}}" bindtap="openMember">
    <view class="action-head"><view class="section-title">{{item.member_name}}</view><view class="type-tag">{{item.action_type_name}}</view></view>
    <view class="muted">{{item.class_name || item.org_name || '当前组织待确认'}}</view>
    <view class="reason">{{item.reason || item.label}}</view>
    <view class="action-footer">
      <text wx:if="{{item.key_time}}">关键时间 {{item.key_time}}</text>
      <text class="action-link">查看学长 ›</text>
    </view>
  </view>
</view>
