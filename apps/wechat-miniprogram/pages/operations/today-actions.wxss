.page-shell{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f8f2ef;color:#3d2a2a}.hero-card{padding:42rpx 34rpx;border-radius:28rpx;background:linear-gradient(135deg,#741f2b,#a84c52);color:#fff}.eyebrow{font-size:24rpx}.hero-title{margin-top:16rpx;font-size:46rpx;font-weight:700}.hero-copy,.reason,.muted{margin-top:14rpx;line-height:1.65;font-size:27rpx}.tab-card{display:flex;margin-top:24rpx;padding:8rpx;border-radius:20rpx;background:#fff}.tab{flex:1;padding:18rpx 8rpx;border-radius:14rpx;text-align:center;color:#806f6f;font-size:26rpx}.tab.active{background:#741f2b;color:#fff}.section-card,.state-card{margin-top:24rpx;padding:28rpx;border-radius:24rpx;background:#fff}.section-title{font-size:32rpx;font-weight:700}.muted{color:#806f6f;font-size:24rpx}.type-tag{display:inline-block;margin-top:18rpx;padding:5rpx 14rpx;border-radius:999rpx;background:#f5e8e6;color:#741f2b;font-size:23rpx}.action-card{border:1rpx solid transparent}.action-card:active{border-color:#b6797d}.error{color:#a42b34}
