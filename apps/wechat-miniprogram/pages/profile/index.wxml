<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">我的成长档案</view>
    <view class="hero-title">我的成长</view>
    <view wx:if="{{member}}" class="hero-copy">{{member.name_masked}}，这里是你的成长记录。</view>
    <view wx:else class="hero-copy">绑定正式学员身份后，可以查看自己的资料。</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在加载，请稍候…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <button wx:if="{{!loading && errorMessage}}" class="plain-button" bindtap="loadProfile">重新加载</button>

  <view wx:if="{{!loading && !member}}" class="section-card empty-card">
    <view class="section-title">先绑定身份</view>
    <view class="section-copy">绑定后才能查看你的班级和学习经历。</view>
    <button class="primary-button" bindtap="openBinding">绑定我的学员身份</button>
  </view>

  <block wx:if="{{!loading && member}}">
    <view class="section-card">
      <view class="section-title">我的身份</view>
      <view class="profile-row"><text class="profile-label">学长</text><text>在册学长身份</text></view>
      <view wx:if="{{currentVolunteerServices.length}}" class="profile-row"><text class="profile-label">志工</text><text>当前承担 {{currentVolunteerServices.length}} 项志工服务</text></view>
      <view wx:if="{{isEmployee}}" class="profile-row"><text class="profile-label">工作人员</text><text>{{employeeName || '工作人员移动运营身份'}}</text></view>
    </view>
    <view class="section-card">
      <view class="section-title">我的资料</view>
      <view class="profile-row"><text class="profile-label">姓名</text><text>{{member.name_masked}}</text></view>
      <view class="profile-row"><text class="profile-label">班级</text><text>{{member.class_name || '暂未记录'}}</text></view>
      <view class="profile-row"><text class="profile-label">小组</text><text>{{member.study_group_name || '暂未记录'}}</text></view>
      <view class="profile-row"><text class="profile-label">入塾时间</text><text>{{joinDateLabel}}</text></view>
    </view>

    <view class="section-card">
      <view class="section-heading"><view class="section-title">学习记录</view><text wx:if="{{learningCount !== null}}" class="record-count">累计 {{learningCount}}次</text></view>
      <view class="section-copy">学习会、班级学习日、小组学习会、开班和课程</view>
      <view wx:if="{{learningErrorMessage}}" class="empty-copy error">{{learningErrorMessage}}</view>
      <block wx:elif="{{recentLearning.length}}">
        <view wx:for="{{recentLearning}}" wx:key="uiKey" class="participation-row">
          <view class="participation-title">{{item.title}}</view>
          <view class="volunteer-meta">{{item.occurredAtLabel}} · {{item.learning_type}}<text wx:if="{{item.status_name}}"> · {{item.status_name}}</text></view>
          <view wx:if="{{item.scopeLabel}}" class="volunteer-meta">{{item.scopeLabel}}</view>
        </view>
      </block>
      <view wx:else class="empty-copy">暂无学习记录</view>
      <button class="plain-button" data-kind="learning" bindtap="openHistory">查看全部学习记录</button>
    </view>

    <view class="section-card">
      <view class="section-title">我的学分</view>
      <view class="empty-copy">只展示本人正式入账的学分。分类总分和每条记录可在“我的学习”中查看。</view>
      <button class="plain-button" bindtap="openLearning">查看我的学分</button>
    </view>

    <view class="section-card">
      <view class="section-heading"><view class="section-title">活动记录</view><text wx:if="{{activityCount !== null}}" class="record-count">累计 {{activityCount}}次</text></view>
      <view class="section-copy">学习以外的其他活动</view>
      <view wx:if="{{activityErrorMessage}}" class="empty-copy error">{{activityErrorMessage}}</view>
      <block wx:elif="{{recentActivities.length}}">
        <view wx:for="{{recentActivities}}" wx:key="uiKey" class="participation-row">
          <view class="participation-title">{{item.title}}</view>
          <view class="volunteer-meta">{{item.occurredAtLabel}} · {{item.learning_type}}<text wx:if="{{item.status_name}}"> · {{item.status_name}}</text></view>
          <view wx:if="{{item.scopeLabel}}" class="volunteer-meta">{{item.scopeLabel}}</view>
        </view>
      </block>
      <view wx:else class="empty-copy">暂无活动记录</view>
      <button class="plain-button" data-kind="activity" bindtap="openHistory">查看全部活动记录</button>
    </view>

    <view class="section-card">
      <view class="section-title">当前志工服务</view>
      <view wx:if="{{currentVolunteerServices.length}}">
        <view wx:for="{{currentVolunteerServices}}" wx:key="key" class="volunteer-row">{{item.positionName}} · {{item.scopeName}}</view>
      </view>
      <view wx:else class="empty-copy">{{volunteerErrorMessage || '暂无当前志工服务'}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">志工经历</view>
      <view wx:if="{{volunteerAppointments.length}}">
        <view wx:for="{{volunteerAppointments}}" wx:key="key" class="volunteer-row">
          <view>{{item.positionName}} · {{item.scopeName}}</view>
          <view class="volunteer-meta">{{item.rangeLabel}} · {{item.statusName}}</view>
        </view>
      </view>
      <view wx:else class="empty-copy">{{volunteerErrorMessage || '暂无志工服务记录'}}</view>
    </view>
  </block>

  <button class="plain-button home-button" bindtap="backHome">返回首页</button>
</view>
