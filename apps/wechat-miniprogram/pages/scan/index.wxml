<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">快速入口</view>
    <view class="hero-title">活动签到</view>
    <view class="hero-copy">请使用微信扫一扫现场活动小程序码，直接进入对应场次签到。</view>
  </view>


  <view wx:if="{{statusMessage}}" class="state-card {{statusType}}">{{statusMessage}}</view>
  <button wx:if="{{showBindButton}}" class="secondary-button" bindtap="openBinding">绑定我的学员身份</button>
  <button class="plain-button home-button" bindtap="backHome">返回首页</button>
</view>
