<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">盛和塾 · 快速入口</view>
    <view class="hero-title">扫码</view>
    <view class="hero-copy">扫描活动或学习会二维码，系统会自动打开对应服务。</view>
  </view>

  <view class="scan-card">
    <view class="scan-mark">扫</view>
    <view class="scan-title">开始扫码</view>
    <view class="scan-copy">请将二维码放入取景框内</view>
    <button class="primary-button" loading="{{scanning}}" disabled="{{scanning}}" bindtap="startScan">{{scanning ? '正在扫码…' : '打开相机扫码'}}</button>
  </view>

  <view wx:if="{{statusMessage}}" class="state-card {{statusType}}">{{statusMessage}}</view>
  <button wx:if="{{showBindButton}}" class="secondary-button" bindtap="openBinding">绑定我的学员身份</button>
  <button wx:if="{{showScanAgain}}" class="plain-button" bindtap="clearStatus">再扫一次</button>
  <button class="plain-button home-button" bindtap="backHome">返回首页</button>
</view>
