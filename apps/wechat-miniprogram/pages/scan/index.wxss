.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #fbf7f3; color: #3d2a2a; }
.hero-card { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #741f2b, #a84c52); color: #fff; box-shadow: 0 16rpx 34rpx rgba(116, 31, 43, .18); }
.eyebrow { font-size: 24rpx; opacity: .82; letter-spacing: 2rpx; }
.hero-title { margin-top: 16rpx; font-size: 50rpx; font-weight: 700; }
.hero-copy { margin-top: 16rpx; line-height: 1.65; font-size: 27rpx; opacity: .92; }
.scan-card { margin-top: 30rpx; padding: 50rpx 28rpx 34rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); text-align: center; }
.scan-mark { display: inline-flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 34rpx; background: #741f2b; color: #fff; font-size: 54rpx; font-weight: 700; }
.scan-title { margin-top: 24rpx; color: #741f2b; font-size: 38rpx; font-weight: 700; }
.scan-copy { margin-top: 12rpx; color: #806f6f; font-size: 25rpx; }
.primary-button { margin-top: 28rpx; border-radius: 12rpx; background: #741f2b; color: #fff; font-size: 31rpx; }
.secondary-button, .plain-button { margin-top: 16rpx; border: 1rpx solid #d9c7c3; border-radius: 12rpx; color: #741f2b; background: #fff; font-size: 27rpx; }
.secondary-button { border-color: #c89579; background: #fffaf7; }
.state-card { margin-top: 24rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; color: #806f6f; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); line-height: 1.6; font-size: 26rpx; text-align: center; }
.state-card.error { color: #b33b44; }
.home-button { margin-bottom: 24rpx; }
