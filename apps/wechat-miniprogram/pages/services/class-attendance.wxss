@import "../operations/shared.wxss";
.period-tabs,.scene-tabs{display:flex;gap:10rpx;margin-top:24rpx}.tab{flex:1;text-align:center;background:#fff;padding:20rpx 8rpx;border-radius:14rpx;color:#741f2b;font-size:28rpx}.tab.active{background:#741f2b;color:#fff}.period-tabs .tab{background:#f8f2ef}.period-tabs .tab.active{background:#741f2b}.rate-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:22rpx 0}.row text:first-child{flex:1;min-width:0;word-break:break-all}.row text:last-child{flex:none;white-space:nowrap}.metric{font-size:48rpx}
