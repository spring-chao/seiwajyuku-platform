.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #fbf7f3; color: #3d2a2a; }
.hero-card { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #741f2b, #a84c52); color: #fff; box-shadow: 0 16rpx 34rpx rgba(116, 31, 43, .18); }
.eyebrow { font-size: 24rpx; opacity: .82; letter-spacing: 2rpx; }
.hero-title { margin-top: 16rpx; font-size: 50rpx; font-weight: 700; }
.hero-copy { margin-top: 16rpx; line-height: 1.65; font-size: 27rpx; opacity: .92; }
.section-card, .state-card { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-copy, .empty-copy, .service-copy, .service-scope { margin-top: 14rpx; color: #806f6f; line-height: 1.6; font-size: 25rpx; }
.service-card { position: relative; margin-top: 24rpx; padding: 30rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #d8aba3; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.service-title { color: #741f2b; font-size: 36rpx; font-weight: 700; }
.service-scope { color: #9a6b3b; }
.service-arrow { margin-top: 18rpx; color: #741f2b; font-size: 27rpx; font-weight: 600; }
.primary-button { margin-top: 24rpx; border-radius: 12rpx; background: #741f2b; color: #fff; font-size: 29rpx; }
.plain-button { margin-top: 14rpx; border: 1rpx solid #d9c7c3; border-radius: 12rpx; color: #741f2b; background: #fff; font-size: 27rpx; }
.home-button { margin-bottom: 24rpx; }
.error { color: #b33b44; }
