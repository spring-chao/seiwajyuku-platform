<view class="konpa-page">
  <block wx:if="{{!eventId}}">
    <view class="konpa-intro">
      <view class="konpa-heading">选择空巴场次</view>
      <view class="konpa-muted">查看参加意向、订餐人数和最终确认结果。</view>
    </view>
    <view wx:for="{{events}}" wx:key="event_id" class="konpa-event" hover-class="konpa-event-active" data-id="{{item.event_id}}" bindtap="selectEvent">
      <view class="konpa-event-info">
        <view class="konpa-date">{{item.event_date}}</view>
        <view class="konpa-event-name">{{item.name || item.title}}</view>
      </view>
      <text class="konpa-arrow">›</text>
    </view>
    <view wx:if="{{!busy && !error && !events.length}}" class="konpa-notice">暂无可查看的空巴场次</view>
  </block>

  <block wx:if="{{eventId}}">
    <view wx:if="{{deadline}}" class="konpa-summary">
      <view class="konpa-summary-label">最新预计参加</view>
      <view class="konpa-metric"><text class="konpa-number">{{estimatedCount}}</text><text class="konpa-unit">人</text></view>
      <view class="konpa-summary-meta"><text>已确认参加</text><text>{{confirmedCount}} 人</text></view>
      <view class="konpa-summary-meta"><text>自动确认</text><text>{{deadline}}（北京时间）</text></view>
    </view>
    <view wx:if="{{dinnerLocked}}" class="konpa-notice">
      <view class="konpa-roster-title">订餐已锁定 {{dinnerCount}} 人</view>
      <view class="konpa-muted">锁定后新增 {{dinnerAdded}} 人 · 减少 {{dinnerRemoved}} 人</view>
    </view>
    <view class="konpa-toolbar">
      <view><view class="konpa-heading">参加名单</view><view class="konpa-muted">参加优先，未选择排在最后</view></view>
      <button class="konpa-button konpa-outline" bindtap="refresh" disabled="{{busy}}">刷新名单</button>
    </view>
    <view wx:if="{{deadline}}" class="konpa-context">
      <button wx:if="{{canManage && !dinnerLocked}}" class="konpa-button konpa-primary" disabled="{{busy}}" bindtap="lockDinner">订餐时锁定人数</button>
      <view class="konpa-muted">上午用于订餐，下午登记参加计划。空巴结束一周后，待核实记录自动确认。</view>
      <view wx:if="{{!canManage}}" class="konpa-muted">仅显示本组名单，可为未选择的学长补录。</view>
    </view>
    <view wx:if="{{deadline && !error && !rows.length}}" class="konpa-notice">暂无名单记录</view>
    <block wx:for="{{rows}}" wx:key="registration_id">
    <view wx:if="{{index === 0 || item.section !== rows[index - 1].section}}" class="konpa-list-heading">{{item.section}}</view>
    <view class="konpa-person {{item.attendingNow ? 'konpa-person-attending' : ''}}">
      <view class="konpa-person-head">
        <view class="konpa-roster-title">{{item.name}}<text wx:if="{{item.group_name}}" class="konpa-group"> · {{item.group_name}}</text></view>
        <view class="konpa-badges">
          <text wx:if="{{item.attendingNow && item.status !== 'CONFIRMED'}}" class="konpa-status konpa-intent">参加意向</text>
          <text class="konpa-status {{item.status === 'CONFIRMED' ? 'konpa-confirmed' : ''}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <view class="konpa-choices">
        <view>上午 <text>{{item.morning_choice === null ? '未选择' : item.morning_choice ? '参加' : '不参加'}}</text></view>
        <view>下午 <text>{{item.afternoon_choice === null ? '未选择' : item.afternoon_choice ? '参加' : '不参加'}}</text></view>
      </view>
      <view class="konpa-current-choice">{{item.choiceLabel}}</view>
      <view wx:if="{{canManage || item.can_set_intent}}" class="konpa-actions">
        <button class="konpa-button konpa-outline {{item.selectedYes ? 'konpa-selected' : ''}}" disabled="{{busy}}" data-id="{{item.registration_id}}" data-action="set" data-choice="yes" bindtap="update">{{item.selectedYes ? '✓ 参加' : '参加'}}</button>
        <button class="konpa-button konpa-outline {{item.selectedNo ? 'konpa-selected' : ''}}" disabled="{{busy}}" data-id="{{item.registration_id}}" data-action="set" data-choice="no" bindtap="update">{{item.selectedNo ? '✓ 不参加' : '不参加'}}</button>
        <button wx:if="{{canManage && item.canConfirm}}" class="konpa-button konpa-primary konpa-final" disabled="{{busy}}" data-id="{{item.registration_id}}" data-action="confirm" bindtap="update">{{item.confirmLabel}}</button>
      </view>
    </view>
    </block>
  </block>
  <view wx:if="{{busy}}" class="konpa-notice">正在处理…</view>
  <view wx:if="{{error}}" class="konpa-notice konpa-error">{{error}}</view>
</view>
