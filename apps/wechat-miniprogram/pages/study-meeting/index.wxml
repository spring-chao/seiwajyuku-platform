<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">正在解析当前班级、小组和学习周期…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && context}}">
    <view class="hero-card">
      <view class="eyebrow">小组学习会登记</view>
      <view class="hero-title">{{assignment ? assignment.group_name : '开始本次登记'}}</view>
      <view wx:if="{{assignment}}" class="role-copy">{{assignment.position_name || (assignment.role_key === 'CLASS_COUNSELOR' ? '班级志工' : '小组志工')}} · {{assignment.class_name}}</view>
      <view wx:else class="hero-copy">请选择你本次要登记的学习小组。</view>
    </view>

    <view wx:if="{{context.selection_required}}" class="section-card">
      <view class="section-title">请选择本次学习会小组</view>
      <view wx:for="{{context.assignments}}" wx:key="group_org_unit_id" data-group-id="{{item.group_org_unit_id}}" bindtap="chooseGroup" class="assignment {{selectedGroupId === item.group_org_unit_id ? 'selected' : ''}}">
        <view class="assignment-name">{{item.class_name}} · {{item.group_name}}</view>
        <view class="assignment-copy">
          <text wx:if="{{item.current_cycle}}">第 {{item.current_cycle.learning_cycle_index}} 学习周期 · {{item.member_count}} 人</text>
          <text wx:else>{{item.cycle_error || '学习周期暂不可用'}}</text>
        </view>
        <view class="checkmark">{{selectedGroupId === item.group_org_unit_id ? '✓' : '○'}}</view>
      </view>
    </view>

    <view wx:if="{{assignment && assignment.current_cycle && meetingPlanReady}}" class="section-card progress-card">
      <view class="section-title">当前学习进度</view>
      <view class="cycle-number">第 {{assignment.current_cycle.learning_cycle_index}} 学习周期 <text class="cycle-total">/ 36</text></view>
      <view class="summary-line">{{assignment.class_name}} · {{assignment.group_name}}</view>
      <view wx:if="{{assignment.current_cycle.group_meeting_policy !== 'REQUIRED'}}" class="policy-copy">本周期小组会暂停或豁免，仍可登记实际参加情况。</view>
    </view>

    <view wx:if="{{meetingPlanReady}}" class="section-card">
      <view class="section-title">本期小组学习会</view>
      <view class="section-hint">请按本期流程组织学习，空巴为本次流程最后一个环节。</view>
      <view wx:for="{{meetingSteps}}" wx:key="stepNo" class="flow-row">
        <view class="flow-number">{{item.stepNo}}</view>
        <view class="flow-content">{{item.content}}</view>
      </view>
    </view>

    <view wx:if="{{meetingPlanReady && learningContents.length}}" class="section-card">
      <view class="section-title">本期必学</view>
      <view class="section-hint">由志工确认本次是否已由全组完成；不要求每位学员扫码。</view>
      <view wx:for="{{learningContentResults}}" wx:key="uiKey" class="learning-content {{item.completed ? 'completed' : ''}}" data-content-key="{{item.contentKey}}" bindtap="toggleLearningContent">
        <view class="content-check">{{item.completed ? '✓' : '○'}}</view>
        <view class="content-main">
          <view class="content-title">{{item.title}}</view>
          <view wx:if="{{item.description}}" class="content-description">{{item.description}}</view>
          <view class="content-meta"><text wx:if="{{item.required}}" class="required-tag">必学</text><text>{{item.creditLabel}}</text></view>
          <view wx:if="{{item.hasResourceAccess}}" class="resource-hint" data-label="{{item.resourceLabel}}" catchtap="openLearningContent">{{item.resourceLabel}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{meetingPlanReady && !learningContents.length}}" class="section-card empty-card">
      <view class="section-title">本期必学</view>
      <view class="empty-copy">本期无指定视频学习，仍可继续登记参与人员和现场合影。</view>
    </view>

    <view wx:if="{{assignment && assignment.current_cycle && !meetingPlanReady}}" class="state-card error">
      {{meetingPlanError || '当前学习周期内容配置尚未完成，请联系运营人员。'}}
    </view>
    <view wx:if="{{assignment && !assignment.current_cycle}}" class="state-card error">
      {{assignment.cycle_error || '当前学习周期暂不可用，请联系运营人员。'}}
    </view>
    <view wx:if="{{meetingPlanReady}}" class="section-card notice-card">
      <view class="section-hint">下一步选择实际参加本次小组学习会的学长，再上传现场合影。</view>
      <button class="primary-button" bindtap="openMembers">下一步：选择参加学员</button>
    </view>
  </block>
</view>
