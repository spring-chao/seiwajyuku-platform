<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">正在解析当前班级、小组和学习周期…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && context}}">
    <view class="hero-card">
      <view class="eyebrow">小组学习会登记</view>
      <view class="hero-title">{{context.assignment ? context.assignment.group_name : '开始本次登记'}}</view>
      <view wx:if="{{context.assignment}}" class="role-copy">{{context.assignment.position_name || (context.assignment.role_key === 'CLASS_COUNSELOR' ? '班级志工' : '小组志工')}} · {{context.assignment.class_name}} · 第 {{context.assignment.current_cycle.learning_cycle_index}} 学习周期</view>
      <view wx:else class="hero-copy">请选择你本次要登记的学习小组。</view>
    </view>

    <view wx:if="{{context.selection_required}}" class="section-card">
      <view class="section-title">请选择本次学习会小组</view>
      <view wx:for="{{context.assignments}}" wx:key="group_org_unit_id" data-group-id="{{item.group_org_unit_id}}" bindtap="chooseGroup" class="assignment {{selectedGroupId === item.group_org_unit_id ? 'selected' : ''}}">
        <view class="assignment-name">{{item.class_name}} · {{item.group_name}}</view>
        <view class="assignment-copy">
          <text wx:if="{{item.current_cycle}}">第 {{item.current_cycle.learning_cycle_index}} 学习周期 · {{item.member_count}} 人</text>
          <text wx:else>{{item.cycle_error || '学习周期暂不可用'}}</text>
        </view>
        <view class="checkmark">{{selectedGroupId === item.group_org_unit_id ? '✓' : '○'}}</view>
      </view>
    </view>

    <view wx:if="{{context.assignment && context.assignment.current_cycle}}" class="section-card">
      <view class="section-title">{{context.assignment.class_name}} · {{context.assignment.group_name}}</view>
      <view class="summary-line">今天 · 第 {{context.assignment.current_cycle.learning_cycle_index}} 学习周期</view>
      <view class="summary-line">本组学长 {{context.assignment.member_count}} 人</view>
      <view wx:if="{{context.assignment.current_cycle.group_meeting_policy !== 'REQUIRED'}}" class="policy-copy">本周期小组会暂停或豁免，仍可登记实际参加情况。</view>
      <button class="primary-button" bindtap="openMembers">开始登记</button>
    </view>
    <view wx:if="{{context.assignment && !context.assignment.current_cycle}}" class="state-card error">
      {{context.assignment.cycle_error || '当前学习周期暂不可用，请联系运营人员。'}}
    </view>
  </block>
</view>
