.flow-row { display: flex; align-items: flex-start; margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #fffaf7; }
.flow-number { flex: 0 0 42rpx; color: #741f2b; font-size: 29rpx; font-weight: 700; }
.flow-content { flex: 1; min-width: 0; color: #5d4a4a; line-height: 1.55; font-size: 28rpx; overflow-wrap: break-word; word-break: break-all; }
.learning-content { box-sizing: border-box; width: 100%; min-width: 0; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #eee4df; border-radius: 16rpx; background: #fffaf7; }
.learning-content.completed { border-color: #b88773; background: #fff1eb; }
.learning-content.incomplete { border-color: #ddbe9a; background: #fffaf2; }
.content-main { box-sizing: border-box; width: 100%; min-width: 0; }
.content-title { color: #741f2b; line-height: 1.5; font-size: 29rpx; font-weight: 700; overflow-wrap: break-word; word-break: break-all; }
.content-description { margin-top: 8rpx; color: #806f6f; line-height: 1.5; font-size: 24rpx; overflow-wrap: break-word; word-break: break-all; }
.content-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 12rpx; color: #806f6f; font-size: 23rpx; }
.required-tag { padding: 4rpx 10rpx; border-radius: 999rpx; background: #f3dfd2; color: #741f2b; }
.resource-hint { margin-top: 10rpx; color: #9a6b3b; font-size: 23rpx; }
.content-choice-label { margin-top: 18rpx; color: #5d4a4a; font-size: 24rpx; font-weight: 600; }
.completion-options { display: flex; width: 100%; min-width: 0; margin-top: 12rpx; }
.completion-option { display: flex; flex: 1 1 0; align-items: center; justify-content: center; box-sizing: border-box; width: 0; min-width: 0; min-height: 68rpx; margin: 0; padding: 12rpx 10rpx; border: 1rpx solid #dccdc5; border-radius: 12rpx; color: #705d57; background: #fff; font-size: 24rpx; line-height: 1.5; white-space: normal; }
.completion-option::after { border: 0; }
.completion-option + .completion-option { margin-left: 14rpx; }
.completion-option.selected-complete { border-color: #741f2b; color: #fff; background: #741f2b; }
.completion-option.selected-incomplete { border-color: #c9905e; color: #7e532e; background: #fff1df; }
.content-status { margin-top: 12rpx; color: #a36b35; font-size: 23rpx; line-height: 1.55; }
.feature-hint { margin-top: 12rpx; color: #741f2b; line-height: 1.6; font-size: 25rpx; }
.feature-hint.warning { color: #a36b35; }
