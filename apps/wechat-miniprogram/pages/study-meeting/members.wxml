<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">正在加载本组学员…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && assignment && assignment.current_cycle && meetingPlanReady}}">
    <view class="hero-card">
      <view class="eyebrow">{{assignment.class_name}}</view>
      <view class="hero-title">{{assignment.group_name}}</view>
      <view class="hero-copy">第 {{assignment.current_cycle.learning_cycle_index}} 学习周期 · 先一键全选，再取消当天未到的学长。</view>
    </view>
    <view class="section-card">
      <view class="toolbar"><view class="section-title">本组学员 {{members.length}} 人</view><view class="toolbar-actions"><button class="toolbar-button" size="mini" bindtap="selectAll">全选本组</button><button class="toolbar-button" size="mini" bindtap="clearAll">全部取消</button></view></view>
      <view wx:for="{{members}}" wx:key="member_id" class="member-row" data-member-id="{{item.member_id}}" bindtap="toggleMember">
        <view class="checkbox {{selected[item.member_id] ? 'checked' : ''}}">{{selected[item.member_id] ? '✓' : ''}}</view>
        <view class="member-name">{{item.name}}</view>
      </view>
      <view class="count-copy">已选择 {{selectedCount}} / {{members.length}} 人</view>
    </view>

    <view class="section-card cross-card">
      <view class="section-title">其他小组学长 <text wx:if="{{crossSelectedCount}}" class="selected-badge">{{crossSelectedCount}}人</text></view>
      <view class="section-hint">只添加同一班级、其他小组的学长；不会改变正式分组。</view>
      <button class="outline-button" bindtap="toggleCrossSearch">{{showCrossSearch ? '收起搜索' : '+ 添加其他小组学长'}}</button>
      <block wx:if="{{showCrossSearch}}">
        <view class="search-row"><input class="search-input" value="{{searchText}}" bindinput="handleSearch" bindconfirm="searchCross" confirm-type="search" placeholder="输入姓名搜索" /><button class="search-button" loading="{{searching}}" bindtap="searchCross">搜索</button></view>
        <view wx:for="{{crossMembers}}" wx:key="member_id" class="member-row" data-member-id="{{item.member_id}}" bindtap="toggleCross">
          <view class="checkbox {{crossSelected[item.member_id] ? 'checked' : ''}}">{{crossSelected[item.member_id] ? '✓' : ''}}</view>
          <view><view class="member-name">{{item.name}}</view><view class="member-meta">{{item.class_name}} · {{item.group_name}}</view></view>
        </view>
      </block>
      <view wx:if="{{crossSelectedCount}}" class="count-copy">已添加其他小组学长 {{crossSelectedCount}} 人</view>
    </view>
    <button class="primary-button" disabled="{{selectedCount + crossSelectedCount === 0}}" bindtap="continueSubmit">下一步：确认学习会</button>
  </block>
  <view wx:if="{{!loading && assignment && assignment.current_cycle && !meetingPlanReady}}" class="state-card error">
    {{meetingPlanError || '当前学习周期内容配置尚未完成，请联系运营人员。'}}
  </view>
  <view wx:if="{{!loading && assignment && !assignment.current_cycle}}" class="state-card error">
    {{assignment.cycle_error || '当前学习周期暂不可用，请联系运营人员。'}}
  </view>
</view>
