<view class="page-shell">
  <view class="success-card">
    <view class="success-mark">✓</view>
    <view class="success-title">提交成功</view>
    <view class="success-copy">本次学习会登记已保存。</view>
  </view>
  <view wx:if="{{session}}" class="section-card">
    <view class="summary-line">登记编号：{{session.session_code}}</view>
    <view class="summary-line">{{session.class_name}} · {{session.group_name}}</view>
    <view class="summary-line">第 {{session.cycle_index}} 学习周期 · 参加 {{summary.totalCount}} 人</view>
    <view wx:if="{{summary.crossCount}}" class="summary-line">本组 {{summary.homeCount}} 人 · 其他小组 {{summary.crossCount}} 人</view>
    <view wx:if="{{summary.contentCount}}" class="summary-line">已确认本期必学内容 {{summary.completedContentCount}} / {{summary.contentCount}} 项</view>
    <view wx:else class="summary-line">本期无指定视频学习</view>
    <view class="summary-line">小组学习会参加事实已记录，课程学分不在本次登记中单独计算。</view>
    <view wx:if="{{session.evidence}}" class="summary-line">✓ 学习合影已上传</view>
  </view>
  <button class="primary-button" bindtap="backHome">返回首页</button>
</view>
