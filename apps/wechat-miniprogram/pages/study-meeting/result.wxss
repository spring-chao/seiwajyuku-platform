.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #f8f2ef; color: #3d2a2a; }
.success-card { padding: 48rpx 32rpx; border-radius: 28rpx; background: linear-gradient(135deg, #741f2b, #a84c52); color: #fff; text-align: center; }
.success-mark { display: inline-flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; border: 4rpx solid #fff; border-radius: 50%; font-size: 58rpx; }
.success-title { margin-top: 20rpx; font-size: 44rpx; font-weight: 700; }
.success-copy { margin-top: 16rpx; line-height: 1.65; font-size: 26rpx; opacity: .9; }
.section-card { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80, 35, 35, .06); }
.summary-line { margin-top: 12rpx; color: #5d4a4a; font-size: 27rpx; }
.primary-button { margin-top: 24rpx; border-radius: 12rpx; background: #741f2b; color: #fff; font-size: 29rpx; }
