<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">正在准备提交…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && assignment && assignment.current_cycle}}">
    <view class="hero-card">
      <view class="eyebrow">{{assignment.class_name}} · {{assignment.group_name}}</view>
      <view class="hero-title">确认本次学习会</view>
      <view class="hero-copy">第 {{assignment.current_cycle.learning_cycle_index}} 周期 · 提交后保存的是学习事实，不会立即产生积分。</view>
    </view>
    <view class="section-card">
      <view class="section-title">是否集体观看在线课程？</view>
      <view class="radio-row">
        <view class="radio {{!hasCourse ? 'checked' : ''}}" data-value="false" bindtap="handleCourseSwitch">○ 没有</view>
        <view class="radio {{hasCourse ? 'checked' : ''}}" data-value="true" bindtap="handleCourseSwitch">● 有</view>
      </view>
      <picker wx:if="{{hasCourse}}" mode="selector" range="{{courses}}" range-key="course_name" value="{{courseIndex < 0 ? 0 : courseIndex}}" bindchange="handleCourseChange">
        <view class="picker-value {{courseName ? '' : 'placeholder'}}">{{courseName || '请选择一门在线课程'}}</view>
      </picker>
      <view wx:if="{{hasCourse && courseIndex >= 0}}" class="course-hint">{{courses[courseIndex].status === 'CONFIGURED' ? courses[courseIndex].credit_points + ' 分 · 已配置' : '课程学分待配置，本次只记录学习事实'}}</view>
    </view>
    <view class="section-card notice-card">
      <view class="section-title">学习合影</view>
      <view class="section-hint">合影对象存储将在 MVP-B2 接入。本轮先完成成员、周期和课程事实登记。</view>
    </view>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交本次学习会</button>
  </block>
  <view wx:if="{{!loading && assignment && !assignment.current_cycle}}" class="state-card error">
    {{assignment.cycle_error || '当前学习周期暂不可用，请联系运营人员。'}}
  </view>
</view>
