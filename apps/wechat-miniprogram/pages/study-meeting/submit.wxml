<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">正在准备提交…</view>
  <view wx:if="{{!loading && errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <block wx:if="{{!loading && assignment && assignment.current_cycle && meetingPlanReady}}">
    <view class="hero-card">
      <view class="eyebrow">{{assignment.class_name}} · {{assignment.group_name}}</view>
      <view class="hero-title">确认本次学习会</view>
      <view class="hero-copy">第 {{assignment.current_cycle.learning_cycle_index}} 学习周期 · 参加 {{totalCount}} 人</view>
    </view>
    <view class="section-card">
      <view class="section-title">本期小组学习会</view>
      <view class="section-hint">第 {{assignment.current_cycle.learning_cycle_index}} 学习周期 · 空巴为本次流程最后一个环节。</view>
      <view wx:for="{{meetingSteps}}" wx:key="stepNo" class="flow-row">
        <view class="flow-number">{{item.stepNo}}</view>
        <view class="flow-content">{{item.content}}</view>
      </view>
    </view>
    <view class="section-card">
      <view class="section-title">本期学习内容</view>
      <block wx:if="{{learningContentResults.length}}">
        <view class="section-hint">学习完成情况仅作登记；尚未完成或暂不选择，都可提交本次学习会。</view>
        <view wx:for="{{learningContentResults}}" wx:key="uiKey" class="learning-content {{item.completed ? 'completed' : (item.confirmed ? 'incomplete' : '')}}">
          <view class="content-main">
            <view class="content-title">{{item.title}}</view>
            <view wx:if="{{item.description}}" class="content-description">{{item.description}}</view>
            <view class="content-meta"><text wx:if="{{item.required}}" class="required-tag">必学</text><text>{{item.creditLabel}}</text></view>
            <view wx:if="{{item.hasResourceAccess}}" class="resource-hint" data-label="{{item.resourceLabel}}" catchtap="openLearningContent">{{item.resourceLabel}}</view>
            <view class="content-choice-label">本期是否已由全组完成学习？</view>
            <view class="completion-options">
              <button class="completion-option {{item.confirmed && item.completed ? 'selected-complete' : ''}}" data-content-key="{{item.contentKey}}" data-completed="yes" bindtap="setLearningContentCompletion">已完成</button>
              <button class="completion-option incomplete-option {{item.confirmed && !item.completed ? 'selected-incomplete' : ''}}" data-content-key="{{item.contentKey}}" data-completed="no" bindtap="setLearningContentCompletion">尚未完成</button>
            </view>
            <view wx:if="{{item.confirmed && !item.completed}}" class="content-status">已选择尚未完成，可提交本次学习会。</view>
          </view>
        </view>
      </block>
      <view wx:else class="section-hint">本期无指定视频学习，仍可继续登记参与人员和现场合影。</view>
      <view wx:if="{{requiredContentCount}}" class="completion-copy">已选择完成 {{completedRequiredCount}} / {{requiredContentCount}} 项本期指定内容</view>
      <view class="local-state-note">学习完成选项仅用于本次登记页面，不作为提交条件，也不会转换为课程积分。</view>
    </view>
    <view class="section-card">
      <view class="section-title">一张学习合影</view>
      <view class="section-hint">拍一张，或从相册选择。仅用于学习记录核验，默认保留7天。</view>
      <view wx:if="{{photoPath}}" class="photo-preview">
        <image class="study-photo" src="{{photoPath}}" data-path="{{photoPath}}" mode="aspectFit" bindtap="previewPhoto" bindload="photoLoaded" binderror="photoLoadFailed" />
        <view wx:if="{{!photoLoaded}}" class="photo-preview-message {{photoPreviewError ? 'error' : ''}}">{{photoPreviewError ? '合影预览失败，请重新选择图片' : '正在加载合影预览…'}}</view>
        <view wx:if="{{photoLoaded}}" class="photo-preview-caption">{{submitting ? '正在提交，请稍候' : '点击合影查看大图，确认图片内容'}}</view>
      </view>
      <view wx:else class="photo-empty">{{choosingPhoto ? '正在处理合影，请稍候…' : '尚未选择合影'}}</view>
      <view wx:if="{{photoPath}}" class="photo-status {{photoUploadState}}">
        {{photoUploadState === 'uploading' ? '正在上传合影…' : (photoUploadState === 'uploaded' ? '合影上传成功' : (photoUploadState === 'failed' ? '合影上传失败' : '已选择合影 · 待上传'))}}
      </view>
      <view wx:if="{{photoPath && photoUploadState === 'selected'}}" class="photo-help">确认照片无误后，点击下方“提交本次学习会”，合影将随登记一起上传。</view>
      <view wx:if="{{photoFeedback}}" class="photo-feedback" role="alert">{{photoFeedback}}</view>
      <button class="photo-button" bindtap="choosePhoto" loading="{{choosingPhoto}}" disabled="{{submitting || choosingPhoto || !evidenceEnabled}}">{{choosingPhoto ? '正在处理合影…' : (photoPath ? '重新拍摄 / 选择合影' : '拍照 / 选择合影')}}</button>
      <view wx:if="{{!evidenceEnabled}}" class="feature-hint">合影功能尚未开启，请联系运营人员。</view>
    </view>
    <view class="section-card notice-card">
      <view class="section-title">本次登记</view>
      <view class="section-hint">本组 {{homeCount}} 人{{crossSummary}}。提交后即可完成本次学习会登记。</view>
    </view>
    <view wx:if="{{submitError}}" class="submit-feedback" role="alert">{{submitError}}</view>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting || choosingPhoto || !evidenceEnabled || photoPreviewError}}" bindtap="submit">{{submitting ? submitStage : (submitError ? '重试提交本次学习会' : '提交本次学习会')}}</button>
  </block>
  <view wx:if="{{!loading && assignment && assignment.current_cycle && !meetingPlanReady}}" class="state-card error">
    {{meetingPlanError || '当前学习周期内容配置尚未完成，请联系运营人员。'}}
  </view>
  <view wx:if="{{!loading && assignment && !assignment.current_cycle}}" class="state-card error">
    {{assignment.cycle_error || '当前学习周期暂不可用，请联系运营人员。'}}
  </view>
</view>
