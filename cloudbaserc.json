{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "shengheshu-d2g2zyyl99f6c6fc2",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "readingSyncDispatch",
      "dir": "cloudfunctions/reading-sync-dispatch",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 180,
      "memorySize": 128,
      "installDependency": false,
      "description": "22班读书来源采集与自动入账调度；每事件只处理一个班级区间；签名定时器单独管理，见docs/deployment/reading-sync-cloud.md"
    },
    {
      "name": "studyEvidenceCleanup",
      "dir": "cloudfunctions/study-evidence-cleanup",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 128,
      "installDependency": false,
      "description": "受保护地触发 platform-api 合影到期清理；不复制业务逻辑",
      "triggers": [
        {
          "name": "monthlyCoreReports",
          "type": "timer",
          "config": "0 0 2,3,4 1 * * *"
        },
        {
          "name": "studyEvidenceCleanupDaily",
          "type": "timer",
          "config": "0 0 2 * * * *"
        },
        {
          "name": "studyMeetingRosterDaily",
          "type": "timer",
          "config": "0 0 0 * * * *"
        }
      ]
    }
  ],
  "cloudrun": {
    "name": "seiwajyuku-platform-api"
  }
}
